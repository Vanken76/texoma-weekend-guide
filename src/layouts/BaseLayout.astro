---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import businessDirectory from "../../public/data/local-business-directory.json";
import eventDirectory from "../../public/data/local-event-directory.json";
import { buildBreadcrumbJsonLd } from "../utils/breadcrumbJsonLd.js";
import {
  buildBusinessIndex,
  getCurrentEvents,
  getEventsAtVenue,
  toArray
} from "../utils/eventDirectory.js";
import { serializeJsonLd } from "../utils/jsonLd.js";
import {
  buildBusinessRelationshipJsonLd,
  buildEventRelationshipJsonLd
} from "../utils/schemaRelationships.js";
import { buildSiteOrganizationJsonLd } from "../utils/siteOrganizationJsonLd.js";
import { buildSiteWebSiteJsonLd } from "../utils/siteWebSiteJsonLd.js";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Your guide to events, live music, food, lake days, family fun, and local businesses across Texoma.",
  image = "/images/banner.jpg"
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://texomaweekendguide.com");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageSource = image === "/images/businesses/calhouns-2-0-logo.png"
  ? "/images/businesses/calhouns-2-0-logo-facebook-20260807.png"
  : image;
const socialImageURL = new URL(socialImageSource, siteURL);
const isHomePage = Astro.url.pathname === "/";
const organizationJsonLdText = isHomePage
  ? serializeJsonLd(buildSiteOrganizationJsonLd(siteURL))
  : "";
const webSiteJsonLdText = isHomePage
  ? serializeJsonLd(buildSiteWebSiteJsonLd(siteURL))
  : "";
const isAdminPage = /^\/admin(?:\/|-|$)/i.test(Astro.url.pathname);
const isEventAdmin = Astro.url.pathname === "/admin-events" || Astro.url.pathname === "/admin-events/";
const isBusinessAdmin = Astro.url.pathname === "/admin-business" || Astro.url.pathname === "/admin-business/";
const isBusinessGalleryAdmin = Astro.url.pathname === "/admin-business-gallery" || Astro.url.pathname === "/admin-business-gallery/";
const isAdminDashboard = Astro.url.pathname === "/admin-dashboard" || Astro.url.pathname === "/admin-dashboard/";
const isAdminRecord = Astro.url.pathname === "/admin-record" || Astro.url.pathname === "/admin-record/";
const isEventsPage = Astro.url.pathname === "/events" || Astro.url.pathname === "/events/";
const isEventDetail = /^\/events\/[^/]+\/?$/.test(Astro.url.pathname);
const isEventExperience = isEventsPage || isEventDetail;
const isBusinessesPage = Astro.url.pathname === "/businesses" || Astro.url.pathname === "/businesses/";
const isBusinessSection = Astro.url.pathname.startsWith("/businesses/");
const isBusinessDetail = /^\/businesses\/[^/]+\/?$/.test(Astro.url.pathname);
const isSupportPage = Astro.url.pathname === "/support" || Astro.url.pathname === "/support/";

const allBusinesses = businessDirectory.businesses ?? [];
const allEvents = eventDirectory.events ?? [];
const businessBySlug = buildBusinessIndex(allBusinesses);
let relationshipJsonLdText = "";
let breadcrumbJsonLdText = "";

if (isBusinessDetail) {
  const slug = Astro.url.pathname.match(/^\/businesses\/([^/]+)\/?$/)?.[1] || null;
  const business = slug ? businessBySlug.get(slug) : null;

  if (business?.publish_ready === true) {
    breadcrumbJsonLdText = serializeJsonLd(buildBreadcrumbJsonLd({
      items: [
        { name: "Business Directory", url: "/directory/" },
        { name: business.business_name, url: `/businesses/${business.slug}/` }
      ],
      siteUrl: siteURL
    }));

    const manualEventSlugs = new Set(
      toArray(business.related_events ?? business.relatedEvents)
        .map((reference) => typeof reference === "string"
          ? reference
          : reference?.event_slug || reference?.slug || null)
        .filter(Boolean)
    );
    const matchedEvents = getEventsAtVenue(allEvents, business.slug);
    const manualEvents = manualEventSlugs.size > 0
      ? allEvents.filter((event) => manualEventSlugs.has(event.event_slug))
      : [];
    const relatedEvents = getCurrentEvents(
      Array.from(
        new Map(
          [...matchedEvents, ...manualEvents]
            .filter((event) => event?.publish_ready === true && event.event_slug)
            .map((event) => [event.event_slug, event])
        ).values()
      )
    );

    relationshipJsonLdText = serializeJsonLd(buildBusinessRelationshipJsonLd({
      business,
      businessBySlug,
      relatedEvents,
      siteUrl: siteURL
    }));
  }
} else if (isEventDetail) {
  const eventSlug = Astro.url.pathname.match(/^\/events\/([^/]+)\/?$/)?.[1] || null;
  const event = eventSlug
    ? allEvents.find((candidate) => candidate.event_slug === eventSlug && candidate.publish_ready === true)
    : null;
  const hostBusiness = event?.host_business_slug
    ? businessBySlug.get(event.host_business_slug)
    : null;

  if (event) {
    breadcrumbJsonLdText = serializeJsonLd(buildBreadcrumbJsonLd({
      items: [
        { name: "Events", url: "/events/" },
        { name: event.event_name, url: `/events/${event.event_slug}/` }
      ],
      siteUrl: siteURL
    }));

    relationshipJsonLdText = serializeJsonLd(buildEventRelationshipJsonLd({
      event,
      hostBusiness,
      siteUrl: siteURL
    }));
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {isAdminPage && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    {organizationJsonLdText && <script type="application/ld+json" set:html={organizationJsonLdText} />}
    {webSiteJsonLdText && <script type="application/ld+json" set:html={webSiteJsonLdText} />}
    {breadcrumbJsonLdText && <script type="application/ld+json" set:html={breadcrumbJsonLdText} />}
    {relationshipJsonLdText && <script type="application/ld+json" set:html={relationshipJsonLdText} />}
    {isEventExperience && <link rel="stylesheet" href="/event-experience.css?v=1" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Texoma Weekend Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <title>{title}</title>
  </head>

  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    {isEventAdmin && <script is:inline src="/admin-events-publish-fix.js?v=6"></script>}
    {isBusinessAdmin && <script is:inline src="/business-publisher-media-preserve.js?v=1"></script>}
    {isBusinessGalleryAdmin && <script is:inline src="/admin-business-gallery.js?v=2"></script>}
    {isAdminDashboard && <script is:inline src="/admin-dashboard-full-attention.js?v=6"></script>}
    {isAdminDashboard && <script is:inline src="/admin-dashboard-diagnostics-link.js?v=1"></script>}
    {isAdminRecord && <script is:inline src="/admin-record-delete.js?v=2"></script>}
    {isEventsPage && <script is:inline src="/event-address-display.js?v=2"></script>}
    {isEventsPage && <script is:inline src="/event-detail-links.js?v=3"></script>}
    {isEventsPage && <script is:inline src="/event-filter-links.js?v=2"></script>}
    {isEventsPage && <script is:inline src="/event-directory-view.js?v=1"></script>}
    {isEventsPage && <script is:inline src="/event-weekend-filter-fix.js?v=1"></script>}
    {isEventDetail && <script is:inline src="/event-venue-name-fallback.js?v=4"></script>}
    {isBusinessesPage && <script is:inline src="/business-directory-among-the-pages-fix.js?v=1"></script>}
    {isBusinessesPage && <script is:inline src="/business-amenities-filter.js?v=1"></script>}
    {(isBusinessesPage || isBusinessSection) && <script is:inline src="/business-facebook-overrides.js?v=1"></script>}
    {isBusinessSection && <script is:inline src="/business-event-expiration.js?v=2"></script>}
    {isBusinessSection && <script is:inline src="/business-event-name-fallback.js?v=6"></script>}
    {isBusinessSection && <script is:inline src="/business-gallery.js?v=2"></script>}
    {isBusinessSection && <script is:inline src="/business-premium-details.js?v=2"></script>}
    {isBusinessSection && <script is:inline src="/business-geography-links.js?v=1"></script>}
    {isBusinessSection && <script is:inline src="/business-inferred-children.js?v=2"></script>}
    {(isHomePage || isBusinessSection) && <script is:inline src="/business-profile-levels.js?v=1"></script>}
    {isSupportPage && <script is:inline src="/support-listing-clarification.js?v=1"></script>}
  </body>
</html>