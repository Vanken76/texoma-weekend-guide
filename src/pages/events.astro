---
import BaseLayout from "../layouts/BaseLayout.astro";
import directory from "../../public/data/local-event-directory.json";
import businessDirectory from "../../public/data/local-business-directory.json";

const now = new Date();
const today = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Chicago",
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(now);

const businesses = businessDirectory.businesses ?? [];
const businessBySlug = new Map(businesses.map((business) => [business.slug, business]));
const toArray = (value) => Array.isArray(value) ? value : value ? [value] : [];

const getPrimaryVenueSlug = (event) => [
  ...toArray(event.venue_slugs),
  ...toArray(event.venue_slug),
  ...toArray(event.host_business_slug)
].find(Boolean) ?? null;

const withVenueFallbacks = (event) => {
  const venueSlug = getPrimaryVenueSlug(event);
  const business = venueSlug ? businessBySlug.get(venueSlug) : null;
  return {
    ...event,
    venue_name: event.venue_name || event.location_name || business?.business_name || "",
    address: event.address || business?.address || null,
    city: event.city || business?.city || "",
    state: event.state || business?.state || "",
    postal_code: event.postal_code || business?.postal_code || null
  };
};

const isRecurring = (event) => event.recurring === true;
const isActive = (event) => event.active !== false;
const parseRule = (rule = "") => Object.fromEntries(
  String(rule ?? "").split(";").map((part) => part.split("=")).filter(([key, value]) => key && value)
);

const recurrenceEndDate = (event) => {
  if (event.recurrence_end_date) return event.recurrence_end_date;
  const until = parseRule(event.recurrence_rule).UNTIL;
  if (!until || !/^\d{8}/.test(until)) return null;
  return `${until.slice(0, 4)}-${until.slice(4, 6)}-${until.slice(6, 8)}`;
};

const isCurrent = (event) => {
  if (!isActive(event)) return false;
  if (isRecurring(event)) {
    const endDate = recurrenceEndDate(event);
    return !endDate || endDate >= today;
  }
  if (event.end_datetime) return new Date(event.end_datetime) >= now;
  return Boolean(event.start_datetime && event.start_datetime.slice(0, 10) >= today);
};

const formatDate = (value) => new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Chicago",
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(value));

const formatTime = (value) => new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Chicago",
  hour: "numeric",
  minute: "2-digit"
}).format(new Date(value));

const events = (directory.events ?? [])
  .map(withVenueFallbacks)
  .filter((event) => event.publish_ready === true)
  .filter((event) => ["upcoming", "recurring"].includes(event.status))
  .filter(isCurrent)
  .sort((a, b) => {
    if (isRecurring(a) !== isRecurring(b)) return isRecurring(a) ? 1 : -1;
    return new Date(a.start_datetime).getTime() - new Date(b.start_datetime).getTime();
  });

const cities = [...new Set(events.map((event) => event.city).filter(Boolean))].sort();
const categories = [...new Set(events.flatMap((event) => event.categories ?? []).filter(Boolean))].sort();
---

<BaseLayout
  title="Events | Texoma Weekend Guide"
  description="Browse and filter upcoming and recurring events across Texoma, including live music, nightlife, family fun, community activities, and more."
>
  <section class="events-page container">
    <header class="page-header">
      <p class="eyebrow">Texoma Event Directory</p>
      <h1>Upcoming Events</h1>
      <p>Discover what is happening across Denison, Sherman, Lake Texoma, and the surrounding region.</p>
    </header>

    {events.length ? (
      <>
        <section class="event-filters" aria-label="Filter upcoming events">
          <div class="filter-grid">
            <label class="search-field">Search events<input id="event-search" type="search" placeholder="Music, venue, city, performer…" autocomplete="off" /></label>
            <label>When<select id="date-filter"><option value="all">All upcoming dates</option><option value="today">Today</option><option value="tomorrow">Tomorrow</option><option value="weekend">This weekend</option><option value="seven-days">Next 7 days</option><option value="recurring">Recurring events</option></select></label>
            <label>City<select id="city-filter"><option value="all">All cities</option>{cities.map((city) => <option value={city.toLowerCase()}>{city}</option>)}</select></label>
            <label>Category<select id="category-filter"><option value="all">All categories</option>{categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}</select></label>
          </div>
          <div class="quick-filters" aria-label="Quick filters">
            <button type="button" class="quick-filter active" data-quick="all">All</button>
            <button type="button" class="quick-filter" data-quick="free">Free</button>
            <button type="button" class="quick-filter" data-quick="live music">Live Music</button>
            <button type="button" class="quick-filter" data-quick="family">Family</button>
            <button type="button" class="quick-filter" data-quick="nightlife">Nightlife</button>
          </div>
          <div class="filter-summary"><strong id="result-count">{events.length} events</strong><button id="clear-filters" type="button" class="clear-filters">Clear filters</button></div>
        </section>

        <div id="event-grid" class="event-grid">
          {events.map((event) => {
            const recurring = isRecurring(event);
            const searchable = [event.event_name, event.description, event.venue_name, event.address, event.city, event.state, event.organizer_name, event.cost_details, ...(event.categories ?? []), ...(event.tags ?? [])].filter(Boolean).join(" ").toLowerCase();
            return (
              <article
                class:list={["event-card", { "has-image": Boolean(event.image_url), recurring }]}
                data-event-card
                data-search={searchable}
                data-date={event.start_datetime?.slice(0, 10) ?? ""}
                data-city={(event.city ?? "").toLowerCase()}
                data-categories={(event.categories ?? []).join("|").toLowerCase()}
                data-cost={event.cost_type ?? "unknown"}
                data-recurring={recurring ? "true" : "false"}
                data-recurrence-rule={event.recurrence_rule ?? ""}
                data-recurrence-end={recurrenceEndDate(event) ?? ""}
              >
                {event.image_url && <a class="flyer-link" href={event.image_url} target="_blank" rel="noreferrer"><img class="event-flyer" src={event.image_url} alt={event.image_alt || `${event.event_name} flyer`} loading="lazy" /></a>}
                <div class="event-card-body">
                  <div class="event-date"><strong>{recurring ? "Recurring event" : formatDate(event.start_datetime)}</strong><span>{event.start_datetime ? formatTime(event.start_datetime) : ""}{event.end_datetime ? `–${formatTime(event.end_datetime)}` : ""}</span></div>
                  <h2>{event.event_name}</h2>
                  {(event.venue_name || event.city) && <p class="venue">{event.venue_name}{event.city ? `${event.venue_name ? " · " : ""}${event.city}, ${event.state}` : ""}</p>}
                  {event.description && <p>{event.description}</p>}
                  <dl>
                    {event.cost_details && <><dt>Admission</dt><dd>{event.cost_details}</dd></>}
                    {event.age_restriction && <><dt>Age</dt><dd>{event.age_restriction}</dd></>}
                    {event.organizer_name && <><dt>Organizer</dt><dd>{event.organizer_name}</dd></>}
                  </dl>
                  <div class="event-actions">
                    {event.ticket_url && <a class="ticket-link" href={event.ticket_url} target="_blank" rel="noopener noreferrer">Buy tickets</a>}
                    {event.image_url && <a class="secondary-link" href={event.image_url} target="_blank" rel="noreferrer">View full flyer</a>}
                    {event.facebook_url && <a class="event-link" href={event.facebook_url} target="_blank" rel="noreferrer">Official event information</a>}
                    {!event.facebook_url && event.official_url && event.official_url !== event.ticket_url && <a class="event-link" href={event.official_url} target="_blank" rel="noreferrer">Official event information</a>}
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <nav id="pagination" class="pagination" aria-label="Event pages" hidden>
          <button id="previous-page" type="button">Previous</button>
          <div id="page-numbers" class="page-numbers"></div>
          <button id="next-page" type="button">Next</button>
        </nav>

        <section id="no-results" class="empty-state" hidden><h2>No events match those filters.</h2><p>Try clearing one or more filters to see additional upcoming events.</p><button id="clear-empty" type="button">Show all events</button></section>
      </>
    ) : (
      <section class="empty-state"><h2>No upcoming events are listed yet.</h2><p>Check the Weekend Roundup or submit an event for consideration.</p></section>
    )}
  </section>

  <script>
    const PAGE_SIZE = 20;
    const searchInput = document.querySelector("#event-search");
    const dateFilter = document.querySelector("#date-filter");
    const cityFilter = document.querySelector("#city-filter");
    const categoryFilter = document.querySelector("#category-filter");
    const resultCount = document.querySelector("#result-count");
    const noResults = document.querySelector("#no-results");
    const pagination = document.querySelector("#pagination");
    const previousPage = document.querySelector("#previous-page");
    const nextPage = document.querySelector("#next-page");
    const pageNumbers = document.querySelector("#page-numbers");
    const cards = [...document.querySelectorAll("[data-event-card]")];
    const quickButtons = [...document.querySelectorAll("[data-quick]")];
    let quickFilter = "all";
    let currentPage = 1;

    const chicagoDate = (date = new Date()) => new Intl.DateTimeFormat("en-CA", { timeZone: "America/Chicago", year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
    const addDays = (dateString, days) => { const date = new Date(`${dateString}T12:00:00`); date.setDate(date.getDate() + days); return chicagoDate(date); };
    const parseRule = (rule = "") => Object.fromEntries(String(rule ?? "").split(";").map((part) => part.split("=")).filter(([key, value]) => key && value));
    const dayCode = (dateString) => ["SU", "MO", "TU", "WE", "TH", "FR", "SA"][new Date(`${dateString}T12:00:00`).getDay()];

    const occursOn = (eventDate, targetDate, recurrenceRule, recurrenceEnd) => {
      if (!eventDate || targetDate < eventDate || (recurrenceEnd && targetDate > recurrenceEnd)) return false;
      const rule = parseRule(recurrenceRule);
      const frequency = rule.FREQ ?? "WEEKLY";
      const interval = Math.max(1, Number.parseInt(rule.INTERVAL ?? "1", 10) || 1);
      const start = new Date(`${eventDate}T12:00:00`);
      const target = new Date(`${targetDate}T12:00:00`);
      const daysApart = Math.round((target.getTime() - start.getTime()) / 86400000);

      if (frequency === "DAILY") return daysApart % interval === 0;
      if (frequency === "WEEKLY") {
        const allowedDays = (rule.BYDAY ?? dayCode(eventDate)).split(",");
        return allowedDays.includes(dayCode(targetDate)) && Math.floor(daysApart / 7) % interval === 0;
      }
      if (frequency === "MONTHLY") {
        const monthsApart = (target.getFullYear() - start.getFullYear()) * 12 + target.getMonth() - start.getMonth();
        const allowedMonthDays = (rule.BYMONTHDAY ?? String(start.getDate())).split(",").map(Number);
        return monthsApart >= 0 && monthsApart % interval === 0 && allowedMonthDays.includes(target.getDate());
      }
      if (frequency === "YEARLY") {
        const yearsApart = target.getFullYear() - start.getFullYear();
        return yearsApart >= 0 && yearsApart % interval === 0 && target.getMonth() === start.getMonth() && target.getDate() === start.getDate();
      }
      return targetDate === eventDate;
    };

    const rangeContainsOccurrence = (card, rangeStart, rangeEnd) => {
      const eventDate = card.dataset.date ?? "";
      if (card.dataset.recurring !== "true") return eventDate >= rangeStart && eventDate <= rangeEnd;
      for (let date = rangeStart; date <= rangeEnd; date = addDays(date, 1)) {
        if (occursOn(eventDate, date, card.dataset.recurrenceRule ?? "", card.dataset.recurrenceEnd ?? "")) return true;
      }
      return false;
    };

    const matchesDate = (card, selected) => {
      if (selected === "all") return true;
      const recurring = card.dataset.recurring === "true";
      if (selected === "recurring") return recurring;
      const current = chicagoDate();
      if (selected === "today") return rangeContainsOccurrence(card, current, current);
      if (selected === "tomorrow") { const tomorrow = addDays(current, 1); return rangeContainsOccurrence(card, tomorrow, tomorrow); }
      if (selected === "seven-days") return rangeContainsOccurrence(card, current, addDays(current, 6));
      if (selected === "weekend") {
        const base = new Date(`${current}T12:00:00`);
        const friday = addDays(current, (5 - base.getDay() + 7) % 7);
        return rangeContainsOccurrence(card, friday, addDays(friday, 2));
      }
      return true;
    };

    const filteredCards = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? "";
      const selectedDate = dateFilter?.value ?? "all";
      const selectedCity = cityFilter?.value ?? "all";
      const selectedCategory = categoryFilter?.value ?? "all";
      return cards.filter((card) => {
        const search = card.dataset.search ?? "";
        const categories = card.dataset.categories ?? "";
        return (!query || search.includes(query))
          && matchesDate(card, selectedDate)
          && (selectedCity === "all" || card.dataset.city === selectedCity)
          && (selectedCategory === "all" || categories.split("|").includes(selectedCategory))
          && (quickFilter === "all" || (quickFilter === "free" && card.dataset.cost === "free") || categories.includes(quickFilter) || search.includes(quickFilter));
      });
    };

    const renderPagination = (totalPages) => {
      if (!pagination || !pageNumbers || !previousPage || !nextPage) return;
      pagination.hidden = totalPages <= 1;
      previousPage.disabled = currentPage === 1;
      nextPage.disabled = currentPage === totalPages;
      pageNumbers.innerHTML = "";
      for (let page = 1; page <= totalPages; page += 1) {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = String(page);
        button.className = "page-number";
        button.setAttribute("aria-label", `Go to page ${page}`);
        if (page === currentPage) {
          button.classList.add("active");
          button.setAttribute("aria-current", "page");
        }
        button.addEventListener("click", () => {
          currentPage = page;
          applyFilters(false);
          document.querySelector(".event-filters")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        pageNumbers.appendChild(button);
      }
    };

    const applyFilters = (resetPage = true) => {
      if (resetPage) currentPage = 1;
      const matches = filteredCards();
      const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const visibleSet = new Set(matches.slice(start, end));
      cards.forEach((card) => { card.hidden = !visibleSet.has(card); });

      if (resultCount) {
        resultCount.textContent = matches.length
          ? `Showing ${start + 1}–${Math.min(end, matches.length)} of ${matches.length} events`
          : "0 events";
      }
      if (noResults) noResults.hidden = matches.length !== 0;
      if (pagination) pagination.hidden = matches.length === 0 || totalPages <= 1;
      renderPagination(totalPages);
    };

    [searchInput, dateFilter, cityFilter, categoryFilter].forEach((control) => control?.addEventListener(control === searchInput ? "input" : "change", () => applyFilters(true)));
    quickButtons.forEach((button) => button.addEventListener("click", () => {
      quickFilter = button.dataset.quick ?? "all";
      quickButtons.forEach((item) => item.classList.toggle("active", item === button));
      applyFilters(true);
    }));
    previousPage?.addEventListener("click", () => { if (currentPage > 1) { currentPage -= 1; applyFilters(false); document.querySelector(".event-filters")?.scrollIntoView({ behavior: "smooth", block: "start" }); } });
    nextPage?.addEventListener("click", () => { const totalPages = Math.ceil(filteredCards().length / PAGE_SIZE); if (currentPage < totalPages) { currentPage += 1; applyFilters(false); document.querySelector(".event-filters")?.scrollIntoView({ behavior: "smooth", block: "start" }); } });
    document.querySelector("#clear-filters")?.addEventListener("click", () => location.reload());
    document.querySelector("#clear-empty")?.addEventListener("click", () => location.reload());
    applyFilters(true);
  </script>
</BaseLayout>

<style>
  .events-page { padding-block: 3rem 5rem; }
  .page-header { max-width: 760px; margin-bottom: 2rem; }
  .eyebrow { margin: 0 0 .4rem; color: #176f95; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0 0 .75rem; color: #103a58; font-size: clamp(2.2rem, 7vw, 4.5rem); }
  .event-filters { margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #d7e0e4; border-radius: 1rem; background: #fffdf8; }
  .filter-grid { display: grid; grid-template-columns: minmax(220px,2fr) repeat(3,minmax(150px,1fr)); gap: .85rem; align-items: end; }
  .event-filters label { display: grid; gap: .35rem; color: #103a58; font-weight: 800; }
  .event-filters input,.event-filters select { width: 100%; min-height: 46px; padding: .7rem .8rem; border: 1px solid #bfcdd4; border-radius: .65rem; background: white; color: #1f2933; font: inherit; }
  .quick-filters,.event-actions { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1rem; }
  .quick-filter,.clear-filters,.empty-state button,.pagination button { min-height: 42px; padding: .6rem .9rem; border: 1px solid #176f95; border-radius: 999px; background: white; color: #176f95; font: inherit; font-weight: 850; cursor: pointer; }
  .quick-filter.active,.page-number.active { background: #176f95; color: white; }
  .filter-summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1rem; }
  .event-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.25rem; align-items: start; }
  .event-card { overflow: hidden; border: 1px solid #d7e0e4; border-radius: 1rem; background: #fffdf8; box-shadow: 0 12px 30px rgba(16,58,88,.08); }
  .event-card[hidden] { display: none; }
  .event-card-body { padding: 1.35rem; }
  .event-card h2 { margin: .8rem 0 .35rem; color: #103a58; }
  .flyer-link { display: block; background: #eef4f6; }
  .event-flyer { display: block; width: 100%; max-height: 520px; object-fit: contain; }
  .event-date { display: flex; flex-direction: column; gap: .2rem; color: #176f95; }
  .venue { margin-bottom: .35rem; font-weight: 800; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: .35rem .75rem; margin: 1rem 0; }
  dt { font-weight: 900; }
  dd { margin: 0; }
  .event-link,.secondary-link,.ticket-link { display: inline-block; padding: .75rem 1rem; border-radius: .65rem; font-weight: 900; text-decoration: none; }
  .event-link { background: #176f95; color: white; }
  .ticket-link { background: #236b45; color: white; }
  .secondary-link { border: 1px solid #176f95; color: #176f95; }
  .pagination { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .6rem; margin-top: 2rem; }
  .page-numbers { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; }
  .pagination button:disabled { cursor: not-allowed; opacity: .45; }
  .empty-state { padding: 2rem; border: 1px solid #d7e0e4; border-radius: 1rem; background: #fffdf8; }
  @media (max-width: 850px) { .filter-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .search-field { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .filter-grid { grid-template-columns: 1fr; } .search-field { grid-column: auto; } .filter-summary { align-items: flex-start; } .pagination { align-items: stretch; } .page-numbers { order: 3; flex-basis: 100%; } }
</style>