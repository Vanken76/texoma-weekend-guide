---
import BaseLayout from "../layouts/BaseLayout.astro";
import directory from "../../public/data/local-event-directory.json";

const now = new Date();
const events = (directory.events ?? [])
  .filter((event) => event.publish_ready === true)
  .filter((event) => ["upcoming", "recurring"].includes(event.status))
  .filter((event) => {
    if (event.end_datetime) return new Date(event.end_datetime) >= now;
    if (event.start_datetime) {
      const localDate = event.start_datetime.slice(0, 10);
      const today = new Intl.DateTimeFormat("en-CA", {
        timeZone: "America/Chicago",
        year: "numeric",
        month: "2-digit",
        day: "2-digit"
      }).format(now);
      return localDate >= today;
    }
    return false;
  })
  .sort((a, b) => new Date(a.start_datetime).getTime() - new Date(b.start_datetime).getTime());

const cities = [...new Set(events.map((event) => event.city).filter(Boolean))].sort();
const categories = [...new Set(events.flatMap((event) => event.categories ?? []).filter(Boolean))].sort();

const formatDate = (value) => new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Chicago",
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(value));

const formatTime = (value) => new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Chicago",
  hour: "numeric",
  minute: "2-digit"
}).format(new Date(value));
---

<BaseLayout
  title="Events | Texoma Weekend Guide"
  description="Browse and filter upcoming events across Texoma, including live music, nightlife, family fun, community activities, and more."
>
  <section class="events-page container">
    <header class="page-header">
      <p class="eyebrow">Texoma Event Directory</p>
      <h1>Upcoming Events</h1>
      <p>Discover what is happening across Denison, Sherman, Lake Texoma, and the surrounding region.</p>
    </header>

    {events.length ? (
      <>
        <section class="event-filters" aria-label="Filter upcoming events">
          <div class="filter-grid">
            <label class="search-field">
              Search events
              <input id="event-search" type="search" placeholder="Music, venue, city, performer…" autocomplete="off" />
            </label>

            <label>
              When
              <select id="date-filter">
                <option value="all">All upcoming dates</option>
                <option value="today">Today</option>
                <option value="tomorrow">Tomorrow</option>
                <option value="weekend">This weekend</option>
                <option value="seven-days">Next 7 days</option>
              </select>
            </label>

            <label>
              City
              <select id="city-filter">
                <option value="all">All cities</option>
                {cities.map((city) => <option value={city.toLowerCase()}>{city}</option>)}
              </select>
            </label>

            <label>
              Category
              <select id="category-filter">
                <option value="all">All categories</option>
                {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
              </select>
            </label>
          </div>

          <div class="quick-filters" aria-label="Quick filters">
            <button type="button" class="quick-filter active" data-quick="all">All</button>
            <button type="button" class="quick-filter" data-quick="free">Free</button>
            <button type="button" class="quick-filter" data-quick="live music">Live Music</button>
            <button type="button" class="quick-filter" data-quick="family">Family</button>
            <button type="button" class="quick-filter" data-quick="nightlife">Nightlife</button>
          </div>

          <div class="filter-summary">
            <strong id="result-count">{events.length} event{events.length === 1 ? "" : "s"}</strong>
            <button id="clear-filters" type="button" class="clear-filters">Clear filters</button>
          </div>
        </section>

        <div id="event-grid" class="event-grid">
          {events.map((event) => {
            const searchable = [
              event.event_name,
              event.description,
              event.venue_name,
              event.city,
              event.state,
              ...(event.categories ?? []),
              ...(event.tags ?? [])
            ].filter(Boolean).join(" ").toLowerCase();

            return (
              <article
                class:list={["event-card", { "has-image": Boolean(event.image_url) }]}
                data-event-card
                data-search={searchable}
                data-date={event.start_datetime?.slice(0, 10) ?? ""}
                data-city={(event.city ?? "").toLowerCase()}
                data-categories={(event.categories ?? []).join("|").toLowerCase()}
                data-cost={event.cost_type ?? "unknown"}
              >
                {event.image_url && (
                  <a class="flyer-link" href={event.image_url} target="_blank" rel="noreferrer" aria-label={`Open flyer for ${event.event_name}`}>
                    <img class="event-flyer" src={event.image_url} alt={`${event.event_name} flyer`} loading="lazy" />
                  </a>
                )}
                <div class="event-card-body">
                  <div class="event-date">
                    <strong>{formatDate(event.start_datetime)}</strong>
                    <span>{formatTime(event.start_datetime)}{event.end_datetime ? `–${formatTime(event.end_datetime)}` : ""}</span>
                  </div>
                  <h2>{event.event_name}</h2>
                  <p class="venue">{event.venue_name}{event.city ? ` · ${event.city}, ${event.state}` : ""}</p>
                  {event.description && <p>{event.description}</p>}
                  <dl>
                    {event.cost_details && <><dt>Admission</dt><dd>{event.cost_details}</dd></>}
                    {event.age_restriction && <><dt>Age</dt><dd>{event.age_restriction}</dd></>}
                  </dl>
                  <div class="event-actions">
                    {event.image_url && <a class="secondary-link" href={event.image_url} target="_blank" rel="noreferrer">View full flyer</a>}
                    {event.facebook_url && <a class="event-link" href={event.facebook_url} target="_blank" rel="noreferrer">Official event information</a>}
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <section id="no-results" class="empty-state" hidden>
          <h2>No events match those filters.</h2>
          <p>Try clearing one or more filters to see additional upcoming events.</p>
          <button id="clear-empty" type="button">Show all events</button>
        </section>
      </>
    ) : (
      <section class="empty-state">
        <h2>No upcoming events are listed yet.</h2>
        <p>Check the Weekend Roundup or submit an event for consideration.</p>
        <div class="actions">
          <a href="/roundups/">Weekend Roundup</a>
          <a href="/submit/">Submit an Event</a>
        </div>
      </section>
    )}
  </section>

  <script>
    const searchInput = document.querySelector("#event-search");
    const dateFilter = document.querySelector("#date-filter");
    const cityFilter = document.querySelector("#city-filter");
    const categoryFilter = document.querySelector("#category-filter");
    const resultCount = document.querySelector("#result-count");
    const noResults = document.querySelector("#no-results");
    const clearButton = document.querySelector("#clear-filters");
    const clearEmptyButton = document.querySelector("#clear-empty");
    const cards = [...document.querySelectorAll("[data-event-card]")];
    const quickButtons = [...document.querySelectorAll("[data-quick]")];
    let quickFilter = "all";

    const chicagoDate = (date = new Date()) => new Intl.DateTimeFormat("en-CA", {
      timeZone: "America/Chicago",
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }).format(date);

    const addDays = (dateString, days) => {
      const date = new Date(`${dateString}T12:00:00`);
      date.setDate(date.getDate() + days);
      return chicagoDate(date);
    };

    const matchesDate = (eventDate, selected) => {
      if (selected === "all") return true;
      const today = chicagoDate();
      if (selected === "today") return eventDate === today;
      if (selected === "tomorrow") return eventDate === addDays(today, 1);
      if (selected === "seven-days") return eventDate >= today && eventDate <= addDays(today, 6);
      if (selected === "weekend") {
        const base = new Date(`${today}T12:00:00`);
        const day = base.getDay();
        const daysUntilFriday = (5 - day + 7) % 7;
        const friday = addDays(today, daysUntilFriday);
        const sunday = addDays(friday, 2);
        return eventDate >= friday && eventDate <= sunday;
      }
      return true;
    };

    const applyFilters = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? "";
      const selectedDate = dateFilter?.value ?? "all";
      const selectedCity = cityFilter?.value ?? "all";
      const selectedCategory = categoryFilter?.value ?? "all";
      let visible = 0;

      cards.forEach((card) => {
        const search = card.dataset.search ?? "";
        const eventDate = card.dataset.date ?? "";
        const city = card.dataset.city ?? "";
        const categories = card.dataset.categories ?? "";
        const cost = card.dataset.cost ?? "unknown";

        const queryMatch = !query || search.includes(query);
        const dateMatch = matchesDate(eventDate, selectedDate);
        const cityMatch = selectedCity === "all" || city === selectedCity;
        const categoryMatch = selectedCategory === "all" || categories.split("|").includes(selectedCategory);
        const quickMatch = quickFilter === "all"
          || (quickFilter === "free" && cost === "free")
          || categories.includes(quickFilter)
          || search.includes(quickFilter);

        const show = queryMatch && dateMatch && cityMatch && categoryMatch && quickMatch;
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (resultCount) resultCount.textContent = `${visible} event${visible === 1 ? "" : "s"}`;
      if (noResults) noResults.hidden = visible !== 0;
    };

    const resetFilters = () => {
      if (searchInput) searchInput.value = "";
      if (dateFilter) dateFilter.value = "all";
      if (cityFilter) cityFilter.value = "all";
      if (categoryFilter) categoryFilter.value = "all";
      quickFilter = "all";
      quickButtons.forEach((button) => button.classList.toggle("active", button.dataset.quick === "all"));
      applyFilters();
    };

    [searchInput, dateFilter, cityFilter, categoryFilter].forEach((control) => {
      control?.addEventListener(control === searchInput ? "input" : "change", applyFilters);
    });

    quickButtons.forEach((button) => {
      button.addEventListener("click", () => {
        quickFilter = button.dataset.quick ?? "all";
        quickButtons.forEach((item) => item.classList.toggle("active", item === button));
        applyFilters();
      });
    });

    clearButton?.addEventListener("click", resetFilters);
    clearEmptyButton?.addEventListener("click", resetFilters);
  </script>
</BaseLayout>

<style>
  .events-page { padding-block: 3rem 5rem; }
  .page-header { max-width: 760px; margin-bottom: 2rem; }
  .eyebrow { margin: 0 0 .4rem; color: #176f95; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0 0 .75rem; color: #103a58; font-size: clamp(2.2rem, 7vw, 4.5rem); }
  .event-filters { margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #d7e0e4; border-radius: 1rem; background: #fffdf8; box-shadow: 0 8px 24px rgba(16,58,88,.06); }
  .filter-grid { display: grid; grid-template-columns: minmax(220px,2fr) repeat(3,minmax(150px,1fr)); gap: .85rem; align-items: end; }
  .event-filters label { display: grid; gap: .35rem; color: #103a58; font-weight: 800; }
  .event-filters input,.event-filters select { width: 100%; min-height: 46px; padding: .7rem .8rem; border: 1px solid #bfcdd4; border-radius: .65rem; background: white; color: #1f2933; font: inherit; }
  .quick-filters { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1rem; }
  .quick-filter,.clear-filters,.empty-state button { min-height: 42px; padding: .6rem .9rem; border: 1px solid #176f95; border-radius: 999px; background: white; color: #176f95; font: inherit; font-weight: 850; cursor: pointer; }
  .quick-filter.active { background: #176f95; color: white; }
  .filter-summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1rem; color: #103a58; }
  .clear-filters { border: 0; padding-inline: .35rem; background: transparent; text-decoration: underline; }
  .event-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.25rem; align-items: start; }
  .event-card { overflow: hidden; border: 1px solid #d7e0e4; border-radius: 1rem; background: #fffdf8; box-shadow: 0 12px 30px rgba(16,58,88,.08); }
  .event-card[hidden] { display: none; }
  .event-card-body { padding: 1.35rem; }
  .event-card h2 { margin: .8rem 0 .35rem; color: #103a58; }
  .flyer-link { display: block; background: #eef4f6; }
  .event-flyer { display: block; width: 100%; max-height: 520px; object-fit: contain; }
  .event-date { display: flex; flex-direction: column; gap: .2rem; color: #176f95; }
  .venue { font-weight: 800; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: .35rem .75rem; margin: 1rem 0; }
  dt { font-weight: 900; }
  dd { margin: 0; }
  .event-actions,.actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .event-link,.secondary-link,.actions a { display: inline-block; padding: .75rem 1rem; border-radius: .65rem; font-weight: 900; text-decoration: none; }
  .event-link,.actions a { background: #176f95; color: white; }
  .secondary-link { border: 1px solid #176f95; color: #176f95; background: transparent; }
  .empty-state { padding: 2rem; border: 1px solid #d7e0e4; border-radius: 1rem; background: #fffdf8; }
  @media (max-width: 850px) { .filter-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .search-field { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .filter-grid { grid-template-columns: 1fr; } .search-field { grid-column: auto; } .filter-summary { align-items: flex-start; } }
</style>
