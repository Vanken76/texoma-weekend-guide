---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Event Publisher | Texoma Weekend Guide"
  description="Private single-event publishing utility for the Texoma Weekend Guide directory."
>
  <section class="publisher">
    <header>
      <p class="eyebrow">TWG Admin</p>
      <h1>Single-Event Publisher</h1>
      <p>Paste one event record, optionally attach its official flyer, and publish it directly to the current Event Directory.</p>
      <p><a href="/admin">← Return to main admin</a></p>
    </header>

    <section class="panel auth-panel">
      <label for="admin-key">Admin key</label>
      <input id="admin-key" type="password" autocomplete="current-password" placeholder="Enter your private publishing key" />
      <p class="helper">The key is saved only for this browser tab.</p>
    </section>

    <section class="panel tool-panel">
      <label for="event-json">Event JSON</label>
      <textarea id="event-json" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder='Paste one event object here, beginning with { and ending with }'></textarea>

      <label for="event-flyer">Official event flyer <span class="optional">optional</span></label>
      <input id="event-flyer" type="file" accept="image/jpeg,image/png,image/webp" />
      <p class="helper">JPG, PNG, or WebP, up to 8 MB. The publisher names it from event_slug and automatically sets image_url.</p>
      <div id="flyer-preview-wrap" class="image-preview-wrap" hidden>
        <img id="flyer-preview" alt="Selected event flyer preview" />
        <p id="flyer-details" class="helper"></p>
      </div>

      <label for="remove-slugs">Old duplicate event slug(s) to remove <span class="optional">optional</span></label>
      <input id="remove-slugs" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="Separate multiple old slugs with commas" />
      <p class="helper">The new event slug will never be removed.</p>

      <div class="actions">
        <button id="validate" type="button">Validate Event</button>
        <button id="publish" type="button" disabled>Publish Event</button>
      </div>

      <section class="results" aria-live="polite">
        <h2>Event status</h2>
        <p id="status">Nothing has been validated yet.</p>
        <ul id="checks"></ul>
      </section>
    </section>
  </section>

  <script>
    const adminKey = document.querySelector("#admin-key");
    const eventInput = document.querySelector("#event-json");
    const flyerInput = document.querySelector("#event-flyer");
    const removeSlugsInput = document.querySelector("#remove-slugs");
    const validateButton = document.querySelector("#validate");
    const publishButton = document.querySelector("#publish");
    const status = document.querySelector("#status");
    const checks = document.querySelector("#checks");
    const flyerPreviewWrap = document.querySelector("#flyer-preview-wrap");
    const flyerPreview = document.querySelector("#flyer-preview");
    const flyerDetails = document.querySelector("#flyer-details");

    if (
      !(adminKey instanceof HTMLInputElement) ||
      !(eventInput instanceof HTMLTextAreaElement) ||
      !(flyerInput instanceof HTMLInputElement) ||
      !(removeSlugsInput instanceof HTMLInputElement) ||
      !(validateButton instanceof HTMLButtonElement) ||
      !(publishButton instanceof HTMLButtonElement) ||
      !(status instanceof HTMLElement) ||
      !(checks instanceof HTMLUListElement) ||
      !(flyerPreviewWrap instanceof HTMLElement) ||
      !(flyerPreview instanceof HTMLImageElement) ||
      !(flyerDetails instanceof HTMLElement)
    ) throw new Error("Event publisher controls could not be initialized.");

    const allowedStatuses = new Set(["draft", "upcoming", "recurring", "postponed", "canceled", "ended"]);
    const allowedCostTypes = new Set(["free", "paid", "donation", "varies", "unknown"]);
    const allowedImageTypes = new Set(["image/jpeg", "image/png", "image/webp"]);
    const savedKey = sessionStorage.getItem("twg-admin-key");
    if (savedKey) adminKey.value = savedKey;
    adminKey.addEventListener("input", () => adminKey.value ? sessionStorage.setItem("twg-admin-key", adminKey.value) : sessionStorage.removeItem("twg-admin-key"));

    let validatedEvent = null;

    const setResult = (message, items = [], valid = false) => {
      status.textContent = message;
      status.className = valid ? "success" : "error";
      checks.replaceChildren(...items.map((item) => {
        const li = document.createElement("li");
        li.textContent = item;
        return li;
      }));
    };

    const selectedFlyer = () => flyerInput.files?.[0] || null;

    flyerInput.addEventListener("change", () => {
      validatedEvent = null;
      publishButton.disabled = true;
      const file = selectedFlyer();
      flyerPreviewWrap.hidden = !file;
      if (!file) {
        flyerPreview.removeAttribute("src");
        flyerDetails.textContent = "";
        return;
      }
      flyerPreview.src = URL.createObjectURL(file);
      flyerDetails.textContent = `${file.name} — ${(file.size / 1024 / 1024).toFixed(2)} MB`;
    });

    const validateEvent = () => {
      validatedEvent = null;
      publishButton.disabled = true;
      try {
        const event = JSON.parse(eventInput.value);
        const problems = [];
        const warnings = [];
        if (!event || typeof event !== "object" || Array.isArray(event)) throw new Error("The event must be one JSON object, not an array or full directory.");
        if (!event.event_name || typeof event.event_name !== "string") problems.push("event_name is required.");
        if (!event.event_slug || typeof event.event_slug !== "string") problems.push("event_slug is required.");
        else if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(event.event_slug)) problems.push("event_slug must use lowercase letters, numbers, and single hyphens only.");
        if (!event.start_datetime || Number.isNaN(Date.parse(event.start_datetime))) problems.push("start_datetime is required and must be valid.");
        if (event.end_datetime && Number.isNaN(Date.parse(event.end_datetime))) problems.push("end_datetime must be null or valid.");
        if (event.end_datetime && event.start_datetime && Date.parse(event.end_datetime) < Date.parse(event.start_datetime)) problems.push("end_datetime cannot be before start_datetime.");
        if (!allowedStatuses.has(event.status)) problems.push("status is invalid.");
        if (!allowedCostTypes.has(event.cost_type)) problems.push("cost_type is invalid.");
        if (event.image_url && !/^\/images\/events\/[a-z0-9-]+\.(jpg|png|webp)$/.test(event.image_url)) problems.push("image_url must use the /images/events/ folder.");

        const flyer = selectedFlyer();
        if (flyer && !allowedImageTypes.has(flyer.type)) problems.push("Flyer must be a JPG, PNG, or WebP image.");
        if (flyer && flyer.size > 8 * 1024 * 1024) problems.push("Flyer must be 8 MB or smaller.");
        if (!flyer && !event.image_url) warnings.push("No flyer selected and image_url is empty.");

        if (problems.length) {
          setResult("Event validation found problems.", problems, false);
          return false;
        }

        validatedEvent = event;
        publishButton.disabled = false;
        const oldSlugs = removeSlugsInput.value.split(",").map((slug) => slug.trim()).filter(Boolean);
        setResult("Valid event JSON. It is ready to publish.", [
          `Event: ${event.event_name}`,
          `Slug: ${event.event_slug}`,
          `Starts: ${event.start_datetime}`,
          event.publish_ready === true ? "Publish-ready: yes" : "Publish-ready: no",
          flyer ? `New flyer selected: ${flyer.name}` : (event.image_url ? `Existing image path: ${event.image_url}` : warnings[0]),
          oldSlugs.length ? `Old slug(s) marked for removal: ${oldSlugs.join(", ")}` : "No old duplicate slugs marked for removal"
        ].filter(Boolean), true);
        return true;
      } catch (error) {
        setResult(`Invalid JSON: ${error instanceof Error ? error.message : "Unknown validation error."}`, [], false);
        return false;
      }
    };

    eventInput.addEventListener("input", () => { validatedEvent = null; publishButton.disabled = true; });
    removeSlugsInput.addEventListener("input", () => { if (validatedEvent) validateEvent(); });
    validateButton.addEventListener("click", validateEvent);

    publishButton.addEventListener("click", async () => {
      if (!validatedEvent && !validateEvent()) return;
      if (!adminKey.value) {
        setResult("Enter the admin key before publishing.", [], false);
        adminKey.focus();
        return;
      }

      publishButton.disabled = true;
      publishButton.textContent = "Publishing…";
      const removeSlugs = removeSlugsInput.value.split(",").map((slug) => slug.trim()).filter(Boolean);

      try {
        const form = new FormData();
        form.append("event", JSON.stringify(validatedEvent));
        form.append("remove_slugs", JSON.stringify(removeSlugs));
        const flyer = selectedFlyer();
        if (flyer) form.append("flyer", flyer, flyer.name);

        const response = await fetch("/api/publish-events", {
          method: "POST",
          headers: { "x-admin-key": adminKey.value },
          body: form
        });
        const result = await response.json();
        if (!response.ok) {
          setResult(result.error || `Publishing failed with status ${response.status}.`, Array.isArray(result.problems) ? result.problems : [], false);
          return;
        }

        setResult(result.message || "Event published successfully.", [
          `${result.event_count} total events now stored`,
          `${result.publish_ready_count} publish-ready events now stored`,
          result.removed_count ? `${result.removed_count} old duplicate record(s) removed` : "No old duplicate records removed",
          result.image_path ? `Flyer uploaded: ${result.image_path.replace(/^public/, "")}` : "No new flyer uploaded",
          result.commit ? `GitHub commit: ${result.commit.slice(0, 7)}` : "GitHub commit created"
        ], true);
      } catch (error) {
        setResult(`Publishing failed: ${error instanceof Error ? error.message : "Unknown publishing error."}`, [], false);
      } finally {
        publishButton.disabled = !validatedEvent;
        publishButton.textContent = "Publish Event";
      }
    });
  </script>
</BaseLayout>

<style>
  .publisher { width: min(760px, calc(100% - 2rem)); margin: 0 auto; padding: 3rem 0 5rem; }
  header { margin-bottom: 1.5rem; }
  .eyebrow { margin: 0 0 .35rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  h1,h2 { margin-top: 0; }
  .panel { padding: 1.25rem; border: 1px solid rgba(255,255,255,.16); border-radius: 1rem; background: rgba(255,255,255,.05); }
  .tool-panel { margin-top: 1.25rem; }
  label { display: block; margin: .9rem 0 .5rem; font-weight: 800; }
  input,textarea { width: 100%; padding: .9rem; border: 1px solid rgba(255,255,255,.22); border-radius: .65rem; font: inherit; }
  textarea { min-height: 48vh; resize: vertical; font-family: ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-size: .82rem; line-height: 1.45; }
  .helper { margin: .5rem 0 0; font-size: .9rem; opacity: .78; }
  .optional { font-weight: 400; opacity: .7; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
  button { min-height: 44px; padding: .7rem 1rem; border: 0; border-radius: .6rem; font: inherit; font-weight: 800; cursor: pointer; }
  button:disabled { cursor: not-allowed; opacity: .45; }
  .image-preview-wrap { margin-top: .8rem; padding: .75rem; border: 1px solid rgba(255,255,255,.14); border-radius: .75rem; }
  .image-preview-wrap img { display: block; width: min(100%,520px); max-height: 420px; object-fit: contain; border-radius: .5rem; }
  .results { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.14); }
  .results h2 { margin-bottom: .5rem; font-size: 1.05rem; }
  .results ul { margin-bottom: 0; }
  .success,.error { font-weight: 800; }
  @media (max-width: 640px) {
    .publisher { padding-top: 1.5rem; }
    .panel { padding: .85rem; }
    textarea { min-height: 58vh; }
    .actions button { flex: 1 1 100%; }
  }
</style>
