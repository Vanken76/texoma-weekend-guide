---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Advertise With Texoma Weekend Guide"
  description="Simple local advertising packages from Texoma Weekend Guide: Featured Business Spotlight for $45/month, Single Event Boost for $25, and Flyer + Social for $20. Basic business and event listings stay free."
>
  <section class="advertise-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow light">Simple local advertising</p>
        <h1>Advertise With TWG</h1>
        <p class="hero-copy">
          Real prices. Flexible promotion. No long-term advertising contract required.
        </p>
        <p class="promise">
          Basic business listings and qualifying local event listings are free — and they stay free.
          Paid promotion is for businesses, performers, venues, organizations, and event hosts that want additional visibility.
        </p>
        <div class="hero-actions">
          <a class="button" href="#packages">See Packages & Prices</a>
          <a class="button secondary" href="#contact">Start Your Promotion</a>
        </div>
      </div>

      <div class="price-summary" aria-label="Texoma Weekend Guide advertising prices">
        <p class="stats-label">Starting packages</p>
        <div class="summary-price"><strong>$20</strong><span>Flyer + Social</span></div>
        <div class="summary-price"><strong>$25</strong><span>Single Event Boost</span></div>
        <div class="summary-price"><strong>$45<span>/mo</span></strong><span>Featured Business Spotlight</span></div>
        <p class="stats-note">Need something larger? Custom campaigns are also available.</p>
      </div>
    </div>
  </section>

  <section class="section" id="packages">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Pick what fits</p>
        <h2>Three straightforward ways to get more visibility</h2>
        <p>
          Choose a one-time promotion or stay featured month to month. Standard packages stay available at the posted prices.
        </p>
      </div>

      <div class="package-grid">
        <article class="package-card featured-package">
          <div class="package-topline">
            <span class="package-tag">Monthly spotlight</span>
            <span class="package-price">$45<span>/month</span></span>
          </div>
          <h3>Featured Business Spotlight</h3>
          <p class="package-lead">Stay visible where local customers are actually looking.</p>
          <ul>
            <li>Featured placement on relevant city, county, and/or state pages</li>
            <li>Eligibility for rotating homepage featured placement</li>
            <li>Enhanced business profile with logo and expanded photo/gallery presentation</li>
            <li>2 dedicated social media posts per month</li>
            <li>Facebook Story promotion and reminders</li>
            <li>Priority listing updates</li>
            <li>Up to 2 active upcoming events featured at one time, when applicable</li>
          </ul>
          <p class="package-note"><strong>$45 per month.</strong> No long-term contract required.</p>
          <a class="button package-cta" href="#contact" data-package="Featured Business Spotlight — $45/month">Get Featured — $45/Month</a>
        </article>

        <article class="package-card">
          <div class="package-topline">
            <span class="package-tag">One event</span>
            <span class="package-price">$25</span>
          </div>
          <h3>Single Event Boost</h3>
          <p class="package-lead">Give one event an extra push beyond its free directory listing.</p>
          <ul>
            <li>Featured-event placement on an appropriate TWG geographic page</li>
            <li>Eligibility for rotating homepage event placement</li>
            <li>1 custom promotional flyer or event graphic</li>
            <li>1 dedicated Facebook post</li>
            <li>Facebook Story promotion</li>
            <li>Reminder Story before the event</li>
          </ul>
          <p class="package-note"><strong>$25 per event.</strong> No contract.</p>
          <a class="button package-cta" href="#contact" data-package="Single Event Boost — $25">Boost My Event — $25</a>
        </article>

        <article class="package-card">
          <div class="package-topline">
            <span class="package-tag">Quick promotion</span>
            <span class="package-price">$20</span>
          </div>
          <h3>Flyer + Social</h3>
          <p class="package-lead">Need a polished graphic and a post without a larger campaign?</p>
          <ul>
            <li>1 custom promotional flyer or social graphic</li>
            <li>1 dedicated Facebook post</li>
            <li>TWG promotional presentation appropriate to your business or event</li>
          </ul>
          <p class="package-note"><strong>$20 one time.</strong> No subscription or advertising contract.</p>
          <a class="button package-cta" href="#contact" data-package="Flyer + Social — $20">Get Flyer + Social — $20</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section payment-section" id="pay">
    <div class="container payment-wrap">
      <div>
        <p class="eyebrow">Ready to get started?</p>
        <h2>Send payment and tell us what you want promoted</h2>
        <p>
          Choose the package you want, send payment through Cash App or Venmo, then message us — or reply to your payment — with the details of what you want promoted.
        </p>
      </div>

      <div class="payment-card">
        <p class="payment-label">Send payment via:</p>
        <div class="payment-links">
          <a class="payment-link" href="https://cash.app/$TexomaWeekendGuide" target="_blank" rel="noopener noreferrer">
            <span>Cash App</span>
            <strong>$TexomaWeekendGuide</strong>
          </a>
          <a class="payment-link" href="https://venmo.com/u/TexomaWeekendGuide" target="_blank" rel="noopener noreferrer">
            <span>Venmo</span>
            <strong>@TexomaWeekendGuide</strong>
          </a>
        </div>
        <div class="payment-packages">
          <p><strong>Flyer + Social</strong><span>$20</span></p>
          <p><strong>Single Event Boost</strong><span>$25</span></p>
          <p><strong>Featured Business Spotlight</strong><span>$45/month</span></p>
        </div>
        <a class="button payment-contact" href="#contact">Message Us About Your Promotion</a>
      </div>
    </div>
  </section>

  <section class="section placement-section">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Featured should mean featured</p>
        <h2>High-visibility placement stays intentionally limited</h2>
        <p>
          Featured placement is geographic and rotational rather than homepage-only. That keeps featured areas useful and gives businesses visibility where their local audience is most likely to find them.
        </p>
      </div>

      <div class="limits-grid">
        <article class="limit-card">
          <h3>Featured businesses</h3>
          <p>Texoma Weekend Guide generally keeps featured business inventory around:</p>
          <ul>
            <li><strong>4</strong> businesses on the homepage</li>
            <li><strong>3</strong> businesses per city page</li>
            <li><strong>4</strong> businesses per county page</li>
            <li><strong>6</strong> businesses per state page</li>
          </ul>
          <p>Homepage positions rotate among eligible Featured Business Spotlight clients. Continuous homepage placement is not guaranteed.</p>
        </article>

        <article class="limit-card">
          <h3>Featured events</h3>
          <p>Texoma Weekend Guide generally keeps featured event inventory around:</p>
          <ul>
            <li><strong>6</strong> events on the homepage</li>
            <li><strong>4</strong> events per city page</li>
            <li><strong>6</strong> events per county page</li>
            <li><strong>8</strong> events per state page</li>
          </ul>
          <p>Featured-event positions rotate naturally as event dates approach and expire.</p>
        </article>
      </div>

      <p class="clarification">
        These are operating targets rather than permanent guarantees. Placement depends on geography, relevance, available inventory, campaign timing, and the audience most likely to be interested in the promotion.
      </p>
    </div>
  </section>

  <section class="section compare-section">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Free means free</p>
        <h2>Pay for extra promotion — not for permission to be listed</h2>
        <p>
          A legitimate local business can receive a basic business listing for free. A qualifying local event can receive an event listing for free.
        </p>
      </div>

      <div class="comparison-wrap">
        <table>
          <thead>
            <tr><th>Feature</th><th>Basic listing</th><th>Paid promotion</th></tr>
          </thead>
          <tbody>
            <tr><td>Business directory listing</td><td>Included</td><td>Included</td></tr>
            <tr><td>Qualifying local event listing</td><td>Included</td><td>Included</td></tr>
            <tr><td>Featured geographic placement</td><td>Not guaranteed</td><td>Included when applicable</td></tr>
            <tr><td>Rotating homepage eligibility</td><td>Not guaranteed</td><td>Included with featured packages</td></tr>
            <tr><td>Dedicated social promotion</td><td>Occasional editorial coverage</td><td>Included by package</td></tr>
            <tr><td>Story reminders</td><td>Not guaranteed</td><td>Included by package</td></tr>
            <tr><td>Custom promotional graphics</td><td>Not guaranteed</td><td>Included by package</td></tr>
            <tr><td>Priority listing updates</td><td>Standard queue</td><td>Featured Spotlight benefit</td></tr>
          </tbody>
        </table>
      </div>

      <p class="clarification">
        Free inclusion is never conditioned on purchasing advertising. Paid promotion affects visibility and promotional effort — not whether a legitimate local business or qualifying event can be listed.
      </p>
    </div>
  </section>

  <section class="section custom-section">
    <div class="container example-grid">
      <div>
        <p class="eyebrow light">Need something bigger?</p>
        <h2>Custom campaigns are available too</h2>
        <p>
          Running a festival, grand opening, concert series, major promotion, sponsorship, or multi-event campaign? Texoma Weekend Guide can build a larger campaign around what you actually need.
        </p>
        <p>
          The standard <strong>$20, $25, and $45</strong> packages remain available at the posted prices. Larger campaigns can be quoted separately without replacing the simple options above.
        </p>
      </div>
      <div class="example-card">
        <strong>Custom campaigns may include</strong>
        <ul>
          <li>Multi-event promotion</li>
          <li>Launch or grand-opening campaigns</li>
          <li>Festival or concert-series promotion</li>
          <li>Additional social posts and reminders</li>
          <li>Expanded featured placement</li>
          <li>Custom combinations based on campaign needs</li>
        </ul>
        <a class="button package-cta" href="#contact" data-package="Custom Campaign — Request a Quote">Request a Custom Campaign</a>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Ready to promote something?</p>
        <h2>Choose a package and tell us what you’re promoting</h2>
        <p>
          Send your business or organization name, upcoming dates, links, and the package you want. Texoma Weekend Guide will follow up about the information and materials needed to get started.
        </p>
        <div class="contact-prices">
          <p><strong>Featured Business Spotlight</strong><span>$45/month</span></p>
          <p><strong>Single Event Boost</strong><span>$25</span></p>
          <p><strong>Flyer + Social</strong><span>$20</span></p>
          <p><strong>Custom Campaign</strong><span>Request a quote</span></p>
        </div>
      </div>

      <form class="contact-form" action="https://formsubmit.co/texomaweekendguide@gmail.com" method="POST">
        <input type="hidden" name="_subject" value="TWG Advertising Inquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://texomaweekendguide.com/advertise/?sent=true" />

        <label>Business or organization name<input name="business_name" type="text" required /></label>
        <label>Your name<input name="name" type="text" autocomplete="name" required /></label>
        <label>Email address<input name="email" type="email" autocomplete="email" required /></label>
        <label>Phone number <span>(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
        <label>
          Which package are you interested in?
          <select name="package" id="package-select" required>
            <option value="">Choose a package</option>
            <option>Featured Business Spotlight — $45/month</option>
            <option>Single Event Boost — $25</option>
            <option>Flyer + Social — $20</option>
            <option>Custom Campaign — Request a Quote</option>
          </select>
        </label>
        <label>What would you like to promote?<textarea name="message" rows="6" required></textarea></label>
        <button class="button submit-button" type="submit">Start My Promotion</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const params = new URLSearchParams(window.location.search);
  if (params.get("sent") === "true") {
    const message = document.createElement("div");
    message.className = "sent-message";
    message.textContent = "Thank you — your advertising inquiry was sent successfully.";
    document.querySelector(".contact-form")?.prepend(message);
  }

  const packageSelect = document.querySelector("#package-select");
  document.querySelectorAll("[data-package]").forEach((link) => {
    link.addEventListener("click", () => {
      if (packageSelect instanceof HTMLSelectElement) {
        packageSelect.value = link.getAttribute("data-package") || "";
      }
    });
  });
</script>

<style>
  .advertise-hero { padding: 5rem 0; background: linear-gradient(120deg, var(--navy), #176f95); color: white; }
  .hero-grid, .example-grid, .contact-grid, .payment-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .advertise-hero h1 { margin-bottom: 1rem; color: white; font-size: clamp(3rem, 8vw, 6rem); letter-spacing: -0.04em; text-transform: uppercase; }
  .hero-copy { color: white; font-size: clamp(1.2rem, 2.5vw, 1.65rem); font-weight: 800; }
  .promise { padding-left: 1rem; border-left: 5px solid var(--gold); color: white; font-weight: 700; }
  .light { color: #bfeaf0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }
  .hero-actions .secondary { border-color: white; background: transparent; color: white; }
  .price-summary { display: grid; gap: .8rem; padding: 2rem; border: 1px solid rgba(255,255,255,.3); border-radius: 28px; background: rgba(255,255,255,.12); backdrop-filter: blur(8px); }
  .stats-label { margin: 0; color: #d7f4f7; font-weight: 900; text-transform: uppercase; }
  .summary-price { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.15rem; border-radius: 16px; background: white; color: var(--navy); }
  .summary-price strong { font-size: 2rem; line-height: 1; }
  .summary-price strong span { font-size: .85rem; }
  .summary-price > span { text-align: right; font-weight: 800; }
  .stats-note { margin: .3rem 0 0; color: white; font-size: .9rem; }
  .centered { margin-inline: auto; text-align: center; }
  .package-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: stretch; }
  .package-card { display: flex; flex-direction: column; padding: 1.6rem; border: 1px solid var(--border); border-radius: 22px; background: white; box-shadow: var(--shadow); }
  .featured-package { border: 2px solid var(--navy); }
  .package-topline { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .package-tag { display: inline-block; padding: .35rem .6rem; border-radius: 999px; background: #e9f3f2; color: var(--navy); font-size: .78rem; font-weight: 900; text-transform: uppercase; }
  .package-price { color: var(--navy); font-size: 2.2rem; font-weight: 950; line-height: 1; }
  .package-price span { font-size: .8rem; font-weight: 800; }
  .package-card h3 { margin-bottom: .35rem; color: var(--navy); font-size: 1.45rem; }
  .package-lead { margin-top: 0; font-weight: 750; }
  .package-card ul { padding-left: 1.25rem; }
  .package-card li { margin-bottom: .45rem; }
  .package-note { margin-top: auto; padding-top: .7rem; }
  .package-cta { margin-top: .5rem; text-align: center; }
  .payment-section { background: #f7fbfa; }
  .payment-wrap { align-items: start; }
  .payment-card { padding: 1.6rem; border: 1px solid var(--border); border-radius: 22px; background: white; box-shadow: var(--shadow); }
  .payment-label { margin-top: 0; color: var(--navy); font-weight: 900; text-transform: uppercase; }
  .payment-links { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  .payment-link { display: grid; gap: .2rem; padding: 1rem; border: 2px solid var(--navy); border-radius: 14px; background: white; color: var(--navy); text-decoration: none; }
  .payment-link:hover { background: #eef6f5; }
  .payment-link span { font-size: .82rem; font-weight: 800; text-transform: uppercase; }
  .payment-link strong { font-size: 1.05rem; overflow-wrap: anywhere; }
  .payment-packages { display: grid; gap: .5rem; margin: 1rem 0; }
  .payment-packages p { display: flex; justify-content: space-between; gap: 1rem; margin: 0; padding: .7rem .85rem; border-radius: 10px; background: #eef6f5; }
  .payment-packages span { font-weight: 900; white-space: nowrap; }
  .payment-contact { display: block; text-align: center; }
  .placement-section { background: #eef6f5; }
  .limits-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .limit-card, .example-card { padding: 1.6rem; border: 1px solid var(--border); border-radius: 20px; background: white; box-shadow: var(--shadow); }
  .limit-card h3 { color: var(--navy); }
  .limit-card li { margin-bottom: .4rem; }
  .clarification, .contact-note { margin-top: 1.25rem; padding: 1rem; border-left: 5px solid var(--gold); background: white; font-weight: 700; }
  .compare-section { background: #e9f3f2; }
  .comparison-wrap { overflow-x: auto; border-radius: 20px; box-shadow: var(--shadow); }
  table { width: 100%; min-width: 680px; border-collapse: collapse; background: white; }
  th, td { padding: 1rem; border-bottom: 1px solid var(--border); text-align: left; }
  th { background: var(--navy); color: white; }
  th:not(:first-child), td:not(:first-child) { text-align: center; }
  .custom-section { background: var(--navy); color: white; }
  .custom-section h2, .custom-section p { color: white; }
  .custom-section .example-card { color: var(--ink); }
  .custom-section .example-card ul { margin-bottom: 1rem; }
  .contact-grid { align-items: start; }
  .contact-prices { display: grid; gap: .6rem; margin-top: 1.5rem; }
  .contact-prices p { display: flex; justify-content: space-between; gap: 1rem; margin: 0; padding: .85rem 1rem; border-radius: 12px; background: #eef6f5; }
  .contact-prices span { font-weight: 900; white-space: nowrap; }
  .contact-form { display: grid; gap: 1rem; padding: 1.6rem; border-radius: 22px; background: white; box-shadow: var(--shadow); }
  .contact-form label { display: grid; gap: .35rem; color: var(--navy); font-weight: 800; }
  .contact-form label span { color: var(--muted); font-size: .9rem; font-weight: 500; }
  .contact-form input, .contact-form textarea, .contact-form select { width: 100%; padding: .8rem; border: 1px solid #aebdc5; border-radius: 10px; background: white; color: var(--ink); font: inherit; }
  .contact-form textarea { resize: vertical; }
  .submit-button { border: 0; cursor: pointer; }
  .sent-message { padding: .9rem; border-radius: 10px; background: #dff6e4; color: #145b27; font-weight: 800; }
  @media (max-width: 980px) { .package-grid { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { .hero-grid, .example-grid, .contact-grid, .limits-grid, .payment-wrap { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .advertise-hero { padding: 3.5rem 0; } .summary-price, .contact-prices p, .payment-packages p { align-items: flex-start; flex-direction: column; } .summary-price > span { text-align: left; } .payment-links { grid-template-columns: 1fr; } }
</style>
