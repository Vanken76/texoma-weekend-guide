---
import BaseLayout from "../layouts/BaseLayout.astro";

const advertisingServiceJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Texoma Advertising and Local Promotion",
  serviceType: "Local advertising, business promotion, event promotion, and weekend roundup promotion",
  url: "https://texomaweekendguide.com/advertise/",
  description: "Texoma advertising for local businesses, venues, performers, events, festivals, and organizations through Texoma Weekend Guide.",
  provider: {
    "@type": "Organization",
    "@id": "https://texomaweekendguide.com/#organization",
    name: "Texoma Weekend Guide",
    url: "https://texomaweekendguide.com/"
  },
  areaServed: [
    { "@type": "Place", name: "Texoma" },
    { "@type": "Place", name: "Lake Texoma" },
    { "@type": "City", name: "Sherman", containedInPlace: { "@type": "State", name: "Texas" } },
    { "@type": "City", name: "Denison", containedInPlace: { "@type": "State", name: "Texas" } }
  ]
});
---

<BaseLayout
  title="Texoma Advertising | Advertise With Texoma Weekend Guide"
  description="Texoma advertising for local businesses, events, venues, performers, festivals, and organizations. Reach people across Texoma with website placement, weekend roundup promotion, event graphics, and social promotion."
>
  <script type="application/ld+json" set:html={advertisingServiceJsonLd} />

  <section class="advertise-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow light">Texoma advertising for local businesses & events</p>
        <h1>Texoma Advertising for Local Businesses & Events</h1>
        <p class="hero-copy">
          Texoma Weekend Guide offers local advertising across Texoma to help businesses, venues,
          performers, events, festivals, and organizations get discovered by people looking for things to do.
        </p>
        <p class="promise">
          Basic business listings and qualifying local event listings are free — and they stay free.
          Paid advertising buys additional visibility and promotional effort, not permission to be listed.
        </p>
        <div class="hero-actions">
          <a class="button" href="/advertise/weekend-roundup-event-upgrade/">See the $20 Roundup Upgrade</a>
          <a class="button secondary" href="#packages">See All Promotion Options</a>
        </div>
      </div>

      <aside class="price-summary" aria-label="Texoma Weekend Guide current early-growth advertising rates">
        <p class="stats-label">Current early-growth rates</p>
        <a class="summary-price" href="/advertise/weekend-roundup-event-upgrade/"><strong>$20</strong><span>Weekend Roundup Event Upgrade</span></a>
        <a class="summary-price" href="/advertise/single-event-boost/"><strong>$25</strong><span>Single Event Boost</span></a>
        <a class="summary-price" href="/advertise/flyer-social/"><strong>$20</strong><span>Flyer + Social</span></a>
        <a class="summary-price" href="/advertise/featured-business/"><strong>$45<span>/mo</span></strong><span>Featured Business</span></a>
        <p class="stats-note">No fake countdowns. No long-term advertising contract. Straightforward local promotion at today’s rates.</p>
      </aside>
    </div>
  </section>

  <section class="section seo-target-section" aria-labelledby="texoma-advertising-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Advertising in Texoma</p>
        <h2 id="texoma-advertising-heading">Local advertising built around how people discover Texoma</h2>
        <p>
          Texoma Weekend Guide connects local advertisers with people actively searching for events, restaurants,
          attractions, live music, lake activities, businesses, and weekend plans throughout the region.
          Advertising can be targeted around geography, a specific event, a weekend roundup, or ongoing business visibility.
        </p>
      </div>

      <div class="seo-grid">
        <article class="seo-card">
          <h3>Lake Texoma Advertising</h3>
          <p>Promote marinas, fishing guides, lodging, restaurants, recreation, lake events, and other businesses serving visitors around Lake Texoma.</p>
        </article>
        <article class="seo-card">
          <h3>Sherman & Denison Advertising</h3>
          <p>Reach local audiences in the Sherman-Denison area with business promotion, event visibility, geographic placement, and dedicated social support.</p>
        </article>
        <article class="seo-card">
          <h3>Texoma Event Advertising</h3>
          <p>Give concerts, festivals, fundraisers, grand openings, community events, and other qualifying events extra visibility beyond their free TWG listing.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section growth-section" aria-labelledby="growth-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Audience & search visibility are growing</p>
        <h2 id="growth-heading">TWG reach is accelerating across search and social.</h2>
        <p>
          People are increasingly finding Texoma Weekend Guide through Google and Facebook while looking for local events,
          live music, weekend plans, businesses, lake activities, and places to go around the region.
        </p>
      </div>

      <p class="eyebrow">Google Search visibility</p>
      <div class="growth-grid" aria-label="Recent Google Search visibility">
        <article class="growth-stat">
          <strong>12,000+</strong>
          <span>Google Search impressions in the last 3 months</span>
        </article>
        <article class="growth-stat featured-stat">
          <strong>4,580</strong>
          <span>Google Search impressions in the most recent 7 days</span>
        </article>
        <article class="growth-stat">
          <strong>693</strong>
          <span>Google Search impressions in the most recent 24 hours</span>
        </article>
      </div>

      <div class="growth-callout">
        <strong>Nearly 40% of TWG’s three-month Google Search visibility came in the most recent seven days.</strong>
        <p>
          TWG’s search footprint is expanding alongside a rapidly growing event database, business directory,
          and geographic coverage across Texoma.
        </p>
        <small>Google Search impression figures from Google Search Console, current as of August 30, 2026.</small>
      </div>

      <p class="eyebrow" style="margin-top: 2.5rem;">Facebook audience growth</p>
      <div class="growth-grid" aria-label="Recent Facebook audience growth">
        <article class="growth-stat featured-stat">
          <strong>155.3K</strong>
          <span>Facebook views in the last 28 days</span>
        </article>
        <article class="growth-stat">
          <strong>+134%</strong>
          <span>Growth in Facebook views compared with the previous 28-day period</span>
        </article>
        <article class="growth-stat">
          <strong>596</strong>
          <span>Facebook follows in the last 28 days — up 149%</span>
        </article>
      </div>

      <div class="growth-callout">
        <strong>TWG generated more than 155,000 Facebook views in the most recent 28 days.</strong>
        <p>
          Social reach is growing alongside search visibility, giving local advertisers exposure through both discovery channels rather than relying on a single audience source.
        </p>
        <small>Facebook figures from Meta Business Suite Insights, current as of August 31, 2026.</small>
      </div>
    </div>
  </section>

  <section class="section rate-section" aria-labelledby="rates-heading">
    <div class="container rate-wrap">
      <div>
        <p class="eyebrow light">Advertise early while TWG grows</p>
        <h2 id="rates-heading">Today’s rates reflect where TWG is today.</h2>
      </div>
      <div>
        <p>
          The prices shown here are our <strong>current early-growth advertising rates</strong>.
          As TWG’s audience, search visibility, and promotional reach continue to grow, advertising rates may increase.
        </p>
        <p>
          There is no artificial deadline and no fake scarcity. The opportunity is simple:
          advertise now while TWG is still offering early-stage pricing.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="packages">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Choose your promotion</p>
        <h2>Four simple ways to get more visibility</h2>
        <p>Start with the $20 roundup upgrade, give one event a broader push, get a clean graphic with a dedicated social post, or keep your business visible over time.</p>
      </div>

      <div class="package-grid">
        <article class="package-card roundup-package">
          <div class="package-topline">
            <span class="package-tag">Stand out in the roundup</span>
            <span class="package-price">$20</span>
          </div>
          <h3>Weekend Roundup Event Upgrade</h3>
          <p class="package-lead">Turn one standard roundup listing into a bold visual event inset.</p>
          <p>Your qualifying event still receives its normal free TWG listing. This upgrade adds a custom landscape promotional inset directly inside the appropriate Weekend Roundup page.</p>
          <ul>
            <li>1 custom landscape event inset designed by Texoma Weekend Guide</li>
            <li>Prominent visual placement inside the appropriate Weekend Roundup page</li>
            <li>Event name, date, time, venue, and location displayed in the graphic</li>
            <li>Additional verified event details when available</li>
            <li>Your event remains included in the full TWG event directory</li>
          </ul>
          <p class="package-note"><strong>$20 per event.</strong> One-time secure payment. Roundup placement depends on event timing and available space.</p>
          <div class="package-actions">
            <a class="button package-cta" href="/advertise/weekend-roundup-event-upgrade/">View Example & Details</a>
            <a class="direct-buy" href="https://buy.stripe.com/7sYaEXd1vfP960Peqc2kw04">Buy now — $20 →</a>
          </div>
        </article>

        <article class="package-card">
          <div class="package-topline">
            <span class="package-tag">For one event</span>
            <span class="package-price">$25</span>
          </div>
          <h3>Single Event Boost</h3>
          <p class="package-lead">Give one event an extra push beyond its free directory listing.</p>
          <ul>
            <li>Featured-event placement on an appropriate TWG geographic page</li>
            <li>Eligibility for rotating homepage event placement</li>
            <li>1 custom promotional flyer or event graphic</li>
            <li>1 dedicated Facebook post</li>
            <li>Facebook Story promotion</li>
            <li>Reminder Story before the event</li>
          </ul>
          <p class="package-note"><strong>$25 per event.</strong> One-time secure payment. No contract.</p>
          <div class="package-actions">
            <a class="button package-cta" href="/advertise/single-event-boost/">View Details</a>
            <a class="direct-buy" href="https://buy.stripe.com/aFa14n9PjgTd1Kz95S2kw01">Buy now — $25 →</a>
          </div>
        </article>

        <article class="package-card">
          <div class="package-topline">
            <span class="package-tag">Quick promotion</span>
            <span class="package-price">$20</span>
          </div>
          <h3>Flyer + Social</h3>
          <p class="package-lead">Need a clean graphic and a dedicated social push without a larger campaign?</p>
          <ul>
            <li>1 custom promotional flyer or social graphic</li>
            <li>1 dedicated Facebook post</li>
            <li>TWG promotional presentation appropriate to your business or event</li>
          </ul>
          <p class="package-note"><strong>$20 one time.</strong> Secure one-time payment. No subscription or advertising contract.</p>
          <div class="package-actions">
            <a class="button package-cta" href="/advertise/flyer-social/">View Details</a>
            <a class="direct-buy" href="https://buy.stripe.com/14A4gz2mRcCX4WL1Dq2kw02">Buy now — $20 →</a>
          </div>
        </article>

        <article class="package-card featured-package">
          <div class="package-topline">
            <span class="package-tag">Best for ongoing visibility</span>
            <span class="package-price">$45<span>/month</span></span>
          </div>
          <h3>Featured Business</h3>
          <p class="package-lead">Keep your business visible all month — not just for one post.</p>
          <p>Built for local businesses that want an ongoing TWG presence combining website placement, an enhanced profile, and dedicated social promotion.</p>
          <ul>
            <li>Featured placement on relevant city, county, and/or state pages</li>
            <li>Eligibility for rotating homepage featured placement</li>
            <li>Enhanced business profile with logo and expanded photo/gallery presentation</li>
            <li>2 dedicated social media posts per month</li>
            <li>Facebook Story promotion and reminders</li>
            <li>Priority listing updates</li>
            <li>Up to 2 active upcoming events featured at one time, when applicable</li>
          </ul>
          <p class="package-note"><strong>$45 per month.</strong> Secure recurring card billing through Stripe. Cancel anytime; service continues through the end of the current billing period.</p>
          <div class="package-actions">
            <a class="button package-cta" href="/advertise/featured-business/">View Details</a>
            <a class="direct-buy" href="https://buy.stripe.com/cNi8wPgdH6ez9d181O2kw00">Start now — $45/month →</a>
          </div>
          <a class="manage-link" href="https://billing.stripe.com/p/login/cNi8wPgdH6ez9d181O2kw00">Already subscribed? Manage billing →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section examples-section" aria-labelledby="examples-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Real TWG examples</p>
        <h2 id="examples-heading">See what TWG presentation looks like</h2>
        <p>These are real examples already published by Texoma Weekend Guide — not generic mockups made for this sales page.</p>
      </div>

      <div class="example-grid">
        <article class="example-card roundup-example-card">
          <a class="example-image flyer-example" href="/advertise/weekend-roundup-event-upgrade/">
            <img src="/images/1000043984.png" alt="Texoma Weekend Guide Saturday roundup example featuring a Derryl Perry at Calhoun's 2.0 promotional inset" loading="lazy" />
          </a>
          <div class="example-copy">
            <span class="proof-type">Weekend Roundup Event Upgrade example</span>
            <h3>Derryl Perry at Calhoun’s 2.0</h3>
            <p>A live TWG roundup page showing exactly how an upgraded event can break out of the standard text list with a bold visual inset.</p>
            <a href="/advertise/weekend-roundup-event-upgrade/">See the before-and-after comparison →</a>
          </div>
        </article>

        <article class="example-card">
          <a class="example-image business-example" href="/businesses/calhouns-2-0/">
            <img src="/images/businesses/calhouns-2-0-logo.png" alt="Calhoun's 2.0 logo used on its Texoma Weekend Guide business listing" loading="lazy" />
          </a>
          <div class="example-copy">
            <span class="proof-type">Editorial Business Spotlight example</span>
            <h3>Calhoun’s 2.0</h3>
            <p>A real TWG business presentation showing strong branding, useful local information, and event connections.</p>
            <a href="/businesses/calhouns-2-0/">View the business page →</a>
          </div>
        </article>

        <article class="example-card">
          <a class="example-image business-example" href="/businesses/the-salty-heifer-cafe-denison/">
            <img src="/images/businesses/the-salty-heifer-cafe-denison-logo.jpg" alt="The Salty Heifer Cafe logo used on its Texoma Weekend Guide business listing" loading="lazy" />
          </a>
          <div class="example-copy">
            <span class="proof-type">Editorial Business Spotlight example</span>
            <h3>The Salty Heifer Cafe</h3>
            <p>TWG’s first editorial Business Spotlight and a real example of the local-business presentation already built into the guide.</p>
            <a href="/businesses/the-salty-heifer-cafe-denison/">View the business page →</a>
          </div>
        </article>

        <article class="example-card">
          <div class="example-image flyer-example">
            <img src="/images/1000042734.png" alt="Texoma Weekend Guide Sunday events graphic for August 30, 2026" loading="lazy" />
          </div>
          <div class="example-copy">
            <span class="proof-type">Social roundup example</span>
            <h3>Sunday in Texoma — August 30</h3>
            <p>A real TWG social graphic showing the clean, readable style used to package multiple local events for quick discovery.</p>
            <a href="/advertise/flyer-social/">See Flyer + Social details →</a>
          </div>
        </article>
      </div>

      <p class="editorial-note">
        <strong>Transparency note:</strong> TWG Business Spotlights are editorial selections and are not paid advertising.
        The Derryl Perry roundup inset shown above was created as a complimentary demonstration of the new Weekend Roundup Event Upgrade format; Calhoun’s 2.0 did not purchase that placement.
      </p>
    </div>
  </section>

  <section class="section process-section" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Simple from the start</p>
        <h2 id="process-heading">How it works</h2>
      </div>
      <div class="process-grid">
        <article class="process-step"><span>1</span><h3>Choose a package</h3><p>Open the package page to see exactly what is included and review real TWG examples.</p></article>
        <article class="process-step"><span>2</span><h3>Pay securely</h3><p>Featured Business, Weekend Roundup Event Upgrade, Single Event Boost, and Flyer + Social can be purchased directly through secure Stripe checkout. Custom campaigns start with an inquiry.</p></article>
        <article class="process-step"><span>3</span><h3>Send the details and get started</h3><p>After checkout, TWG follows up for the business or event details, links, images, and branding needed for promotion. Custom campaigns are confirmed and quoted first.</p></article>
      </div>
      <p class="payment-note">Secure payments are processed through Stripe. Featured Business renews at $45/month until canceled. <a href="https://billing.stripe.com/p/login/cNi8wPgdH6ez9d181O2kw00">Existing advertisers can manage billing, invoices, payment methods, and cancellation here.</a></p>
    </div>
  </section>

  <section class="section placement-section" aria-labelledby="placement-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Featured should mean featured</p>
        <h2 id="placement-heading">High-visibility inventory stays intentionally limited</h2>
        <p>TWG does not want every page to become a wall of ads. Paid featured placement is kept limited, geographic, and rotational so it remains useful to advertisers and readers.</p>
      </div>

      <div class="limits-grid">
        <article class="limit-card">
          <h3>Featured businesses</h3>
          <p>Current operating targets are approximately:</p>
          <ul>
            <li><strong>4</strong> businesses on the homepage</li>
            <li><strong>3</strong> businesses per city page</li>
            <li><strong>4</strong> businesses per county page</li>
            <li><strong>6</strong> businesses per state page</li>
          </ul>
          <p>Homepage positions rotate among eligible Featured Business clients. Continuous homepage placement is not guaranteed.</p>
        </article>

        <article class="limit-card">
          <h3>Featured events</h3>
          <p>Current operating targets are approximately:</p>
          <ul>
            <li><strong>6</strong> events on the homepage</li>
            <li><strong>4</strong> events per city page</li>
            <li><strong>6</strong> events per county page</li>
            <li><strong>8</strong> events per state page</li>
          </ul>
          <p>Featured-event positions rotate naturally as event dates approach and expire.</p>
        </article>
      </div>

      <p class="clarification">These are operating targets rather than permanent guarantees or artificial scarcity claims. Placement depends on geography, relevance, available inventory, campaign timing, and the audience most likely to be interested in the promotion.</p>
    </div>
  </section>

  <section class="section compare-section" aria-labelledby="compare-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Free means free</p>
        <h2 id="compare-heading">Pay for extra promotion — not for permission to be listed</h2>
        <p>A legitimate local business can receive a basic business listing for free. A qualifying local event can receive an event listing for free.</p>
      </div>

      <div class="comparison-wrap">
        <table>
          <thead><tr><th>Feature</th><th>Basic listing</th><th>Paid promotion</th></tr></thead>
          <tbody>
            <tr><td>Business directory listing</td><td>Included</td><td>Included</td></tr>
            <tr><td>Qualifying local event listing</td><td>Included</td><td>Included</td></tr>
            <tr><td>Expanded visual inset inside Weekend Roundup</td><td>Not included</td><td>Included with Roundup Event Upgrade</td></tr>
            <tr><td>Featured geographic placement</td><td>Not guaranteed</td><td>Included when applicable</td></tr>
            <tr><td>Rotating homepage eligibility</td><td>Not guaranteed</td><td>Included with featured packages</td></tr>
            <tr><td>Dedicated social promotion</td><td>Occasional editorial coverage</td><td>Included by package</td></tr>
            <tr><td>Story reminders</td><td>Not guaranteed</td><td>Included by package</td></tr>
            <tr><td>Custom promotional graphics</td><td>Not guaranteed</td><td>Included by package</td></tr>
            <tr><td>Priority listing updates</td><td>Standard queue</td><td>Featured Business benefit</td></tr>
          </tbody>
        </table>
      </div>

      <p class="clarification">Free inclusion is never conditioned on purchasing advertising. Paid promotion affects visibility and promotional effort — not whether a legitimate local business or qualifying event can be listed.</p>
      <div class="spotlight-note">
        <strong>TWG Business Spotlight is editorial, not an ad product.</strong>
        <p>Business Spotlights are selected by Texoma Weekend Guide and cannot be purchased. Paid business promotion is identified separately as Featured Business placement.</p>
      </div>
    </div>
  </section>

  <section class="section custom-section" aria-labelledby="custom-heading">
    <div class="container custom-grid">
      <div>
        <p class="eyebrow light">Need something bigger?</p>
        <h2 id="custom-heading">Custom campaigns are available too</h2>
        <p>Running a festival, grand opening, concert series, major promotion, sponsorship, or multi-event campaign? TWG can build a larger campaign around what you actually need.</p>
        <p>Custom campaigns are quoted separately and do not replace the standard advertising options shown above.</p>
      </div>
      <div class="custom-card">
        <strong>Custom campaigns may include</strong>
        <ul>
          <li>Multi-event promotion</li>
          <li>Launch or grand-opening campaigns</li>
          <li>Festival or concert-series promotion</li>
          <li>Additional social posts and reminders</li>
          <li>Expanded featured placement</li>
          <li>Custom combinations based on campaign needs</li>
        </ul>
        <a class="button package-cta" href="/advertise/custom-campaigns/">View Custom Campaign Details</a>
      </div>
    </div>
  </section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-heading">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Need help or something custom?</p>
        <h2 id="contact-heading">Tell TWG what you want to promote.</h2>
        <p>Standard package pages include full details and secure checkout. For a Custom Campaign — or if you have questions before purchasing — send the basic details below.</p>
        <div class="contact-prices">
          <p><strong>Weekend Roundup Event Upgrade</strong><span>$20</span></p>
          <p><strong>Single Event Boost</strong><span>$25</span></p>
          <p><strong>Flyer + Social</strong><span>$20</span></p>
          <p><strong>Featured Business</strong><span>$45/month</span></p>
          <p><strong>Custom Campaign</strong><span>Request a quote</span></p>
        </div>
        <p class="contact-reassurance"><strong>No long-term advertising contract.</strong><br />Basic listings remain free whether you advertise or not.</p>
      </div>

      <form class="contact-form" action="https://formsubmit.co/texomaweekendguide@gmail.com" method="POST">
        <input type="hidden" name="_subject" value="TWG Advertising Inquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://texomaweekendguide.com/advertise/?sent=true" />

        <label>Business or organization name<input name="business_name" type="text" required /></label>
        <label>Your name<input name="name" type="text" autocomplete="name" required /></label>
        <label>Email address<input name="email" type="email" autocomplete="email" required /></label>
        <label>Phone number <span>(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
        <label>
          Which package are you interested in?
          <select name="package" id="package-select" required>
            <option value="">Choose a package</option>
            <option>Weekend Roundup Event Upgrade — $20</option>
            <option>Single Event Boost — $25</option>
            <option>Flyer + Social — $20</option>
            <option>Featured Business — $45/month</option>
            <option>Custom Campaign — Request a Quote</option>
          </select>
        </label>
        <label>What would you like to promote?<textarea name="message" rows="6" placeholder="Tell us what you’re promoting, important dates, links, and anything else TWG should know." required></textarea></label>
        <button class="button submit-button" type="submit">Send My Promotion Request</button>
        <p class="form-note">Standard packages can be purchased through the secure checkout buttons on their detail pages. No payment is required before TWG reviews and confirms custom campaign requests.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const params = new URLSearchParams(window.location.search);
  if (params.get("sent") === "true") {
    const message = document.createElement("div");
    message.className = "sent-message";
    message.textContent = "Thank you — your advertising inquiry was sent successfully. TWG will follow up about the next step.";
    document.querySelector(".contact-form")?.prepend(message);
  }
</script>

<style>
  .advertise-hero { padding: 5rem 0; background: linear-gradient(120deg, var(--navy), #176f95); color: white; }
