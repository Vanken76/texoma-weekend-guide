---
import BaseLayout from "../layouts/BaseLayout.astro";

const advertisingServiceJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Texoma Advertising and Local Promotion",
  serviceType: "Local advertising, business promotion, event promotion, website advertising, weekend roundup advertising, and sponsorship",
  url: "https://texomaweekendguide.com/advertise/",
  description: "Affordable local advertising for Texoma businesses, events, venues, performers, restaurants, services, attractions, and organizations through Texoma Weekend Guide.",
  provider: {
    "@type": "Organization",
    "@id": "https://texomaweekendguide.com/#organization",
    name: "Texoma Weekend Guide",
    url: "https://texomaweekendguide.com/"
  },
  areaServed: [
    { "@type": "Place", name: "Texoma" },
    { "@type": "Place", name: "Lake Texoma" },
    { "@type": "City", name: "Sherman", containedInPlace: { "@type": "State", name: "Texas" } },
    { "@type": "City", name: "Denison", containedInPlace: { "@type": "State", name: "Texas" } }
  ]
});
---

<BaseLayout
  title="Texoma Advertising | Advertise With Texoma Weekend Guide"
  description="Advertise a Texoma business, event, restaurant, service, attraction, or organization with custom graphics, social promotion, Weekend Roundup advertising, website placement, and sponsorships."
>
  <script type="application/ld+json" set:html={advertisingServiceJsonLd} />

  <section class="advertise-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow light">Local advertising built around how Texoma plans the weekend</p>
        <h1>Advertise where people are already looking for what to do next.</h1>
        <p class="hero-copy">
          Texoma Weekend Guide gives local businesses, events, restaurants, entertainers, services, attractions, and organizations practical ways to reach a growing Texoma audience without buying a giant campaign.
        </p>
        <p class="promise">
          Basic business listings and qualifying local event listings are free — and they stay free. Paid advertising buys extra creative work, distribution, website visibility, or sponsorship.
        </p>
        <div class="hero-actions">
          <a class="button" href="/advertise/weekend-roundup-promotion/">See the $20 Roundup Promotion</a>
          <a class="button secondary" href="#packages">Compare Every Option</a>
        </div>
      </div>

      <aside class="price-summary" aria-label="Current Texoma Weekend Guide advertising rates">
        <p class="stats-label">Current early-growth rates</p>
        <a class="summary-price" href="/advertise/custom-flyer/"><strong>$10</strong><span>Custom Flyer</span></a>
        <a class="summary-price" href="/advertise/flyer-social/"><strong>$20</strong><span>Flyer + TWG Social</span></a>
        <a class="summary-price" href="/advertise/weekend-roundup-promotion/"><strong>$20</strong><span>Weekend Roundup Promotion</span></a>
        <a class="summary-price" href="/advertise/single-event-boost/"><strong>$30</strong><span>Single Event Boost</span></a>
        <a class="summary-price" href="/advertise/featured-business/"><strong>$45<span>/mo</span></strong><span>Featured Business — website only</span></a>
        <a class="summary-price" href="/advertise/weekend-roundup-sponsor/"><strong>$100</strong><span>Weekend Roundup Sponsor</span></a>
        <p class="stats-note">Custom campaigns are quoted separately. No fake countdowns and no long-term contract on one-time promotions.</p>
      </aside>
    </div>
  </section>

  <section class="section logic-section" aria-labelledby="pricing-logic-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Simple pricing logic</p>
        <h2 id="pricing-logic-heading">Pay for the thing you actually need.</h2>
        <p>The packages are separated by creative work, audience distribution, ongoing website visibility, and premium sponsorship so a small business does not have to buy a bundle it does not want.</p>
      </div>
      <div class="logic-grid">
        <article><strong>$10</strong><h3>Create it</h3><p>A custom digital flyer or social graphic. No TWG distribution.</p></article>
        <article><strong>$20</strong><h3>Promote it in one channel</h3><p>Choose TWG social promotion or a paid placement inside the Weekend Roundup.</p></article>
        <article><strong>$30</strong><h3>Boost one event</h3><p>Custom flyer + TWG social promotion + Weekend Roundup Promotion.</p></article>
        <article><strong>$45/mo</strong><h3>Stay visible on the website</h3><p>Featured Business is recurring website advertising only.</p></article>
        <article><strong>$100</strong><h3>Sponsor the roundup</h3><p>Own the exclusive title sponsor position for one Weekend Roundup.</p></article>
      </div>
    </div>
  </section>

  <section class="section roundup-section" aria-labelledby="roundup-ad-heading">
    <div class="container roundup-grid">
      <div>
        <p class="eyebrow light">The Weekend Roundup is advertising inventory too</p>
        <h2 id="roundup-ad-heading">You do not need to have an event to advertise in the roundup.</h2>
        <p>A restaurant can invite people in for dinner. A fishing guide can promote trips. A salon can advertise appointments. A retailer can promote a weekend special. An entertainer can promote a show.</p>
        <p>Event promotions can appear as enhanced visual event placements. General business advertising is clearly labeled <strong>Sponsored</strong> or <strong>Advertisement</strong> so the distinction between editorial content and paid promotion stays obvious.</p>
        <a class="button" href="/advertise/weekend-roundup-promotion/">Weekend Roundup Promotion — $20</a>
      </div>
      <div class="sponsor-card">
        <span>Premium option</span>
        <strong>$100</strong>
        <h3>Weekend Roundup Sponsor</h3>
        <p>Instead of buying one placement, sponsor the entire roundup with an exclusive “Sponsored by” or “Presented by” position plus a dedicated sponsor placement inside the roundup.</p>
        <a href="/advertise/weekend-roundup-sponsor/">See sponsorship details →</a>
      </div>
    </div>
  </section>

  <section class="section" id="packages">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Choose your advertising</p>
        <h2>Start small or buy more reach.</h2>
        <p>Every standard package has a defined job. Choose creative only, one distribution channel, a bundled event push, ongoing website visibility, or title-level sponsorship.</p>
      </div>

      <div class="package-grid">
        <article class="package-card">
          <div class="package-topline"><span class="package-tag">Creative only</span><span class="package-price">$10</span></div>
          <h3>Custom Flyer</h3>
          <p class="package-lead">One custom digital promotional graphic. No TWG posting included.</p>
          <ul><li>1 custom flyer or social graphic</li><li>1 minor correction round</li><li>Finished graphic for your own digital use</li></ul>
          <div class="package-actions"><a class="button" href="/advertise/custom-flyer/">View Details</a><a class="direct-buy" href="https://buy.stripe.com/14A00j4uZcCX1Kz3Ly2kw05">Order — $10 →</a></div>
        </article>

        <article class="package-card">
          <div class="package-topline"><span class="package-tag">Creative + social</span><span class="package-price">$20</span></div>
          <h3>Flyer + TWG Social Promotion</h3>
          <p class="package-lead">Get the graphic and one dedicated promotional post through a TWG social channel.</p>
          <ul><li>1 custom promotional graphic</li><li>1 dedicated TWG social promotion</li><li>Copy and presentation tailored to the promotion</li></ul>
          <div class="package-actions"><a class="button" href="/advertise/flyer-social/">View Details</a><a class="direct-buy" href="https://buy.stripe.com/5kQ14n3qV8mH1Kzgyk2kw08">Buy — $20 →</a></div>
        </article>

        <article class="package-card roundup-package">
          <div class="package-topline"><span class="package-tag">Roundup advertising</span><span class="package-price">$20</span></div>
          <h3>Weekend Roundup Promotion</h3>
          <p class="package-lead">One custom paid visual placement inside one eligible Weekend Roundup.</p>
          <ul><li>Event or general business advertising</li><li>Custom visual placement inside the roundup</li><li>Non-event ads clearly marked Sponsored or Advertisement</li></ul>
          <div class="package-actions"><a class="button" href="/advertise/weekend-roundup-promotion/">See Example & Details</a><a class="direct-buy" href="https://buy.stripe.com/14AaEX0eJ7iDexlfug2kw09">Buy — $20 →</a></div>
        </article>

        <article class="package-card">
          <div class="package-topline"><span class="package-tag">One event, multiple channels</span><span class="package-price">$30</span></div>
          <h3>Single Event Boost</h3>
          <p class="package-lead">A custom flyer, one TWG social promotion, and one Weekend Roundup Promotion.</p>
          <ul><li>1 custom event graphic</li><li>1 dedicated TWG social promotion</li><li>1 roundup promotion when timing allows</li></ul>
          <div class="package-actions"><a class="button" href="/advertise/single-event-boost/">View Details</a><a class="direct-buy" href="https://buy.stripe.com/eVq4gz8Lf6ezah5eqc2kw06">Buy — $30 →</a></div>
        </article>

        <article class="package-card featured-package">
          <div class="package-topline"><span class="package-tag">Website-only recurring advertising</span><span class="package-price">$45<span>/mo</span></span></div>
          <h3>Featured Business</h3>
          <p class="package-lead">Ongoing higher-visibility treatment across the TWG website and business directory.</p>
          <ul><li>Featured business-profile treatment</li><li>Higher-visibility website placement when applicable</li><li>Priority profile updates</li><li>No roundup or social promotion bundled in</li></ul>
          <div class="package-actions"><a class="button" href="/advertise/featured-business/">View Details</a><a class="direct-buy" href="https://buy.stripe.com/cNi8wPgdH6ez9d181O2kw00">Start — $45/month →</a></div>
        </article>

        <article class="package-card sponsor-package">
          <div class="package-topline"><span class="package-tag">Premium sponsorship</span><span class="package-price">$100</span></div>
          <h3>Weekend Roundup Sponsor</h3>
          <p class="package-lead">Exclusive title-level sponsorship of one Weekend Roundup.</p>
          <ul><li>“Sponsored by” or “Presented by” recognition</li><li>1 dedicated sponsor placement inside the roundup</li><li>No second title sponsor for that roundup</li></ul>
          <div class="package-actions"><a class="button" href="/advertise/weekend-roundup-sponsor/">View Details</a><a class="direct-buy" href="https://buy.stripe.com/aFaeVde5zbyT88X1Dq2kw07">Sponsor — $100 →</a></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section proof-section" aria-labelledby="proof-heading">
    <div class="container proof-grid">
      <div>
        <p class="eyebrow">Real example</p>
        <h2 id="proof-heading">See what a paid roundup event placement can look like.</h2>
        <p>The current example uses an event because it was the first format tested. The same $20 Weekend Roundup Promotion can also be used for clearly labeled general business advertising.</p>
        <p class="transparency"><strong>Transparency:</strong> The Derryl Perry at Calhoun’s 2.0 placement was created as a complimentary demonstration. Calhoun’s 2.0 did not purchase it.</p>
        <a class="text-link" href="/advertise/weekend-roundup-promotion/">See the full before-and-after comparison →</a>
      </div>
      <a class="proof-image" href="/advertise/weekend-roundup-promotion/"><img src="/images/roundup-upgrade-comparison.webp" alt="Weekend Roundup Promotion before and after comparison" loading="lazy" /></a>
    </div>
  </section>

  <section class="section growth-section" aria-labelledby="growth-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Growing audience</p>
        <h2 id="growth-heading">TWG is still early — and reach is growing.</h2>
        <p>Current rates reflect an early-growth local advertising platform with increasing search and social discovery.</p>
      </div>
      <div class="growth-grid">
        <article><strong>155.3K</strong><span>Facebook views in the 28 days ending August 31, 2026</span></article>
        <article><strong>12,000+</strong><span>Google Search impressions in the three months ending August 30, 2026</span></article>
        <article><strong>4,580</strong><span>Google Search impressions in the seven days ending August 30, 2026</span></article>
      </div>
      <p class="metric-note">Figures are from Meta Business Suite and Google Search Console and are shown with their measurement dates rather than presented as permanent audience guarantees.</p>
    </div>
  </section>

  <section class="section free-section" aria-labelledby="free-heading">
    <div class="container free-grid">
      <div>
        <p class="eyebrow light">Free means free</p>
        <h2 id="free-heading">Advertising buys promotion, not inclusion.</h2>
        <p>A legitimate local business can receive a basic TWG business listing for free. A qualifying local event can receive a free event listing. Buying advertising does not determine whether you are allowed into the directory.</p>
      </div>
      <div class="free-card">
        <strong>Editorial and paid are different.</strong>
        <p>TWG Business Spotlights are editorial selections and cannot be purchased. Paid advertising is identified separately. General business ads inside the Weekend Roundup are labeled Sponsored or Advertisement.</p>
      </div>
    </div>
  </section>

  <section class="section custom-section">
    <div class="container custom-grid">
      <div>
        <p class="eyebrow light">Need something bigger?</p>
        <h2>Custom Campaign</h2>
        <p>If one standard package is not enough, TWG can quote multi-week, multi-event, launch, festival, concert-series, or larger promotional campaigns.</p>
        <a class="button" href="/advertise/custom-campaigns/">See Custom Campaign Options</a>
      </div>
      <div class="custom-card"><strong>Custom quote</strong><p>Multiple roundup placements, multiple social promotions, event series, multi-week sponsorship concepts, and other combinations can be built around the actual campaign.</p></div>
    </div>
  </section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-heading">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Questions before buying?</p>
        <h2 id="contact-heading">Tell TWG what you want to promote.</h2>
        <p>Standard packages can be purchased directly through secure Stripe checkout. Use this form for questions or a Custom Campaign request.</p>
        <div class="contact-prices">
          <p><strong>Custom Flyer</strong><span>$10</span></p>
          <p><strong>Flyer + TWG Social Promotion</strong><span>$20</span></p>
          <p><strong>Weekend Roundup Promotion</strong><span>$20</span></p>
          <p><strong>Single Event Boost</strong><span>$30</span></p>
          <p><strong>Featured Business</strong><span>$45/month</span></p>
          <p><strong>Weekend Roundup Sponsor</strong><span>$100</span></p>
          <p><strong>Custom Campaign</strong><span>Request a quote</span></p>
        </div>
      </div>

      <form class="contact-form" action="https://formsubmit.co/texomaweekendguide@gmail.com" method="POST">
        <input type="hidden" name="_subject" value="TWG Advertising Inquiry" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://texomaweekendguide.com/advertise/?sent=true" />
        <label>Business or organization name<input name="business_name" type="text" required /></label>
        <label>Your name<input name="name" type="text" autocomplete="name" required /></label>
        <label>Email address<input name="email" type="email" autocomplete="email" required /></label>
        <label>Phone number <span>(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
        <label>Which option are you interested in?
          <select name="package" required>
            <option value="">Choose an option</option>
            <option>Custom Flyer — $10</option>
            <option>Flyer + TWG Social Promotion — $20</option>
            <option>Weekend Roundup Promotion — $20</option>
            <option>Single Event Boost — $30</option>
            <option>Featured Business — $45/month</option>
            <option>Weekend Roundup Sponsor — $100</option>
            <option>Custom Campaign — Request a Quote</option>
          </select>
        </label>
        <label>What would you like to promote?<textarea name="message" rows="6" placeholder="Tell us what you’re promoting, important dates, links, and anything else TWG should know." required></textarea></label>
        <button class="button submit-button" type="submit">Send My Advertising Request</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const params = new URLSearchParams(window.location.search);
  if (params.get("sent") === "true") {
    const message = document.createElement("div");
    message.className = "sent-message";
    message.textContent = "Thank you — your advertising inquiry was sent successfully. TWG will follow up about the next step.";
    document.querySelector(".contact-form")?.prepend(message);
  }
</script>

<style>
  .advertise-hero { padding: 5rem 0; background: linear-gradient(120deg, var(--navy), #176f95); color: white; }
  .hero-grid, .roundup-grid, .proof-grid, .free-grid, .custom-grid, .contact-grid { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(300px,.8fr); gap: 3rem; align-items: center; }
  .advertise-hero h1 { max-width: 15ch; margin: .4rem 0 1.2rem; color: white; font-size: clamp(2.7rem,7vw,5.3rem); line-height: .98; letter-spacing: -.045em; }
  .hero-copy { max-width: 760px; color: white; font-size: clamp(1.15rem,2.2vw,1.45rem); font-weight: 800; line-height: 1.5; }
  .promise { max-width: 760px; padding-left: 1rem; border-left: 5px solid var(--gold); color: white; font-weight: 700; line-height: 1.55; }
  .eyebrow { margin: 0; font-size: .8rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
  .light { color: #bfeaf0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .hero-actions .secondary { border: 2px solid rgba(255,255,255,.72); background: transparent; color: white; }
  .price-summary { padding: 1.5rem; border: 1px solid rgba(255,255,255,.2); border-radius: 20px; background: rgba(7,24,43,.44); }
  .stats-label { color: white; font-size: .78rem; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; }
  .summary-price { display: flex; justify-content: space-between; gap: 1rem; padding: .78rem 0; border-bottom: 1px solid rgba(255,255,255,.15); color: white; text-decoration: none; }
  .summary-price strong { color: white; font-size: 1.5rem; }
  .summary-price strong span { font-size: .72rem; }
  .summary-price > span { max-width: 190px; font-weight: 800; text-align: right; }
  .stats-note { color: #d9eef5; font-size: .9rem; line-height: 1.5; }
  .section { padding: 4.5rem 0; }
  .section-heading { max-width: 820px; margin-bottom: 2rem; }
  .section-heading.centered { margin-right: auto; margin-left: auto; text-align: center; }
  .section-heading h2, .roundup-grid h2, .proof-grid h2, .free-grid h2, .custom-grid h2, .contact-grid h2 { margin: .35rem 0 1rem; font-size: clamp(2rem,4.5vw,3.4rem); line-height: 1.02; letter-spacing: -.035em; }
  .section-heading p:last-child, .roundup-grid p, .proof-grid p, .free-grid p, .custom-grid p, .contact-grid p { line-height: 1.6; }
  .logic-section, .proof-section, .growth-section { background: #f5f8fa; }
  .logic-grid { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 1rem; }
  .logic-grid article, .growth-grid article { padding: 1.4rem; border: 1px solid #dbe4e8; border-radius: 16px; background: white; }
  .logic-grid strong, .growth-grid strong { display: block; color: var(--navy); font-size: 2rem; font-weight: 900; }
  .logic-grid h3 { margin: .55rem 0; }
  .logic-grid p { margin-bottom: 0; line-height: 1.5; }
  .roundup-section { background: var(--navy); color: white; }
  .roundup-grid h2, .roundup-grid p { color: white; }
  .sponsor-card { padding: 1.7rem; border: 2px solid var(--gold); border-radius: 18px; background: white; color: #172b39; }
  .sponsor-card span { color: #176f95; font-size: .78rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .sponsor-card > strong { display: block; margin: .4rem 0; color: var(--navy); font-size: 3rem; }
  .sponsor-card p { color: #172b39; }
  .sponsor-card a { font-weight: 900; }
  .package-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.25rem; }
  .package-card { display: flex; flex-direction: column; padding: 1.6rem; border: 1px solid #dbe4e8; border-radius: 16px; background: white; box-shadow: 0 12px 34px rgba(17,44,64,.06); }
  .roundup-package { border: 2px solid #176f95; }
  .featured-package { border: 2px solid var(--gold); }
  .sponsor-package { border: 2px solid var(--navy); }
  .package-topline { display: flex; justify-content: space-between; gap: 1rem; }
  .package-tag { color: #176f95; font-size: .75rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .package-price { color: var(--navy); font-size: 1.8rem; font-weight: 900; white-space: nowrap; }
  .package-price span { font-size: .72rem; }
  .package-card h3 { margin: .9rem 0 .45rem; }
  .package-lead { font-weight: 800; line-height: 1.5; }
  .package-card li { margin: .4rem 0; line-height: 1.5; }
  .package-actions { display: grid; gap: .65rem; margin-top: auto; padding-top: 1rem; }
  .package-actions .button { width: 100%; text-align: center; }
  .direct-buy { font-weight: 900; text-align: center; }
  .proof-image { display: block; overflow: hidden; border-radius: 18px; background: #102c3d; }
  .proof-image img { display: block; width: 100%; height: auto; }
  .transparency { padding: 1rem; border-left: 5px solid var(--gold); background: white; }
  .text-link { font-weight: 900; }
  .growth-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .growth-grid strong { font-size: clamp(2.2rem,5vw,3.5rem); }
  .growth-grid span { display: block; margin-top: .5rem; font-weight: 800; line-height: 1.45; }
  .metric-note { margin-top: 1.2rem; color: #59646c; text-align: center; }
  .free-section, .custom-section { background: var(--navy); color: white; }
  .free-grid h2, .free-grid p, .custom-grid h2, .custom-grid p { color: white; }
  .free-card, .custom-card { padding: 1.6rem; border-radius: 16px; background: white; color: #172b39; }
  .free-card p, .custom-card p { color: #172b39; }
  .free-card strong, .custom-card strong { color: var(--navy); font-size: 1.25rem; }
  .contact-prices { margin-top: 1.5rem; }
  .contact-prices p { display: flex; justify-content: space-between; gap: 1rem; margin: 0; padding: .65rem 0; border-bottom: 1px solid #dbe4e8; }
  .contact-form { display: grid; gap: 1rem; padding: 1.5rem; border: 1px solid #dbe4e8; border-radius: 18px; background: #f7f9fa; }
  .contact-form label { display: grid; gap: .35rem; font-weight: 800; }
  .contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: .8rem; border: 1px solid #bac9d1; border-radius: 9px; background: white; font: inherit; }
  .sent-message { padding: 1rem; border-radius: 10px; background: #e3f4e9; font-weight: 800; }
  @media (max-width: 1000px) { .logic-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 820px) {
    .hero-grid, .roundup-grid, .proof-grid, .free-grid, .custom-grid, .contact-grid, .package-grid, .growth-grid, .logic-grid { grid-template-columns: 1fr; }
    .advertise-hero { padding: 3.8rem 0; }
    .section { padding: 3.5rem 0; }
  }
</style>
