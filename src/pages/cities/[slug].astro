---
import BaseLayout from "../../layouts/BaseLayout.astro";
import geographyDirectory from "../../../public/data/local-geography-directory.json";
import businessDirectory from "../../../public/data/local-business-directory.json";
import eventDirectory from "../../../public/data/local-event-directory.json";
import { businessStateCode } from "../../utils/businessState.js";
import { buildBreadcrumbJsonLd } from "../../utils/breadcrumbJsonLd.js";
import {
  buildBusinessIndex,
  getCurrentEvents,
  getEventVenueSlugs,
  getNextOccurrenceDate,
  isRecurringEvent,
  withResolvedEventLocation
} from "../../utils/eventDirectory.js";
import { serializeJsonLd } from "../../utils/jsonLd.js";

export function getStaticPaths() {
  return (geographyDirectory.entities ?? [])
    .filter((entity) => entity.publish_ready === true && entity.entity_type === "city" && entity.slug)
    .map((entity) => ({ params: { slug: entity.slug }, props: { entity } }));
}

const { entity } = Astro.props;
const allGeography = geographyDirectory.entities ?? [];
const allBusinesses = businessDirectory.businesses ?? [];
const allEvents = eventDirectory.events ?? [];
const businessIndex = buildBusinessIndex(allBusinesses);
const media = entity.media ?? {};
const heroPrimary = media.hero_primary ?? media.hero ?? null;
const heroSecondary = media.hero_secondary ?? null;
const locatorMap = media.outline ?? null;
const gallery = Array.isArray(media.gallery) ? media.gallery.filter((asset) => asset?.url) : [];
const sourceEntries = Array.isArray(entity.sources) ? entity.sources.filter((source) => source?.source_name) : [];

const normalize = (value) => String(value ?? "").trim().toLowerCase();
const normalizeCity = (value) => normalize(value)
  .replace(/,\s*(?:tx|texas|ok|oklahoma)\b.*$/i, "")
  .replace(/-(?:tx|ok)$/i, "")
  .trim();
const toArray = (value) => Array.isArray(value) ? value : value ? [value] : [];
const formatNumber = (value) => Number.isFinite(Number(value))
  ? new Intl.NumberFormat("en-US").format(Number(value))
  : null;
const formatDate = (value) => value
  ? new Intl.DateTimeFormat("en-US", { timeZone: "UTC", month: "long", day: "numeric", year: "numeric" }).format(new Date(`${value}T12:00:00Z`))
  : null;
const formatEventDate = (value) => value
  ? new Intl.DateTimeFormat("en-US", { timeZone: "America/Chicago", weekday: "short", month: "short", day: "numeric" }).format(new Date(`${String(value).slice(0, 10)}T12:00:00Z`))
  : "";
const formatEventTime = (value) => value
  ? new Intl.DateTimeFormat("en-US", { timeZone: "America/Chicago", hour: "numeric", minute: "2-digit" }).format(new Date(value))
  : "";
const todayCentral = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Chicago",
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(new Date());
const eventStartDate = (event = {}) => event.start_datetime?.slice(0, 10) || "";
const eventEndDate = (event = {}) => event.end_datetime?.slice(0, 10) || "";
const isOngoingEvent = (event = {}) => {
  if (isRecurringEvent(event)) return false;
  const startDate = eventStartDate(event);
  const endDate = eventEndDate(event);
  return Boolean(startDate && endDate && startDate < todayCentral && endDate >= todayCentral);
};
const eventDisplayDate = (event = {}) => {
  if (isRecurringEvent(event)) return `Recurring · Next ${formatEventDate(event.next_occurrence_date)}`;
  if (isOngoingEvent(event)) return `Ongoing · Through ${formatEventDate(event.end_datetime)}`;
  return formatEventDate(event.start_datetime);
};
const eventSortDate = (event = {}) => {
  if (isRecurringEvent(event)) return event.next_occurrence_date || "9999-12-31";
  if (isOngoingEvent(event)) return todayCentral;
  return eventStartDate(event) || "9999-12-31";
};

const state = allGeography.find((item) =>
  item.publish_ready === true && item.entity_type === "state" && item.slug === entity.state_slug
) ?? null;
const county = allGeography.find((item) =>
  item.publish_ready === true && item.entity_type === "county" && (item.slug === entity.county_slug || item.slug === entity.parent_slug)
) ?? null;
const stateCode = businessStateCode({ state: state?.abbreviation || state?.name || entity.state_slug });

const cityFromLocationText = (value) => {
  const match = String(value ?? "").match(/,\s*([^,]+),\s*(?:TX|Texas|OK|Oklahoma)\b/i);
  return match?.[1]?.trim() || "";
};
const cityNames = new Set([entity.name, entity.official_name, entity.slug].map(normalizeCity).filter(Boolean));
const cityValuesForRecord = (record = {}) => [
  record.city_slug,
  record.city,
  cityFromLocationText(record.address),
  cityFromLocationText(record.full_address),
  cityFromLocationText(record.formatted_address),
  cityFromLocationText(record.service_area_or_location)
].map(normalizeCity).filter(Boolean);
const recordDirectlyReferencesCity = (record = {}) => {
  if (cityValuesForRecord(record).some((value) => cityNames.has(value))) return true;
  const related = [
    ...toArray(record.related_geography_slugs),
    ...toArray(record.geography_slugs),
    ...toArray(record.tags)
  ].map(normalizeCity);
  return related.some((value) => cityNames.has(value));
};

const cityBusinesses = allBusinesses
  .filter((business) => business.publish_ready === true)
  .filter((business) => !stateCode || businessStateCode(business) === stateCode)
  .filter(recordDirectlyReferencesCity)
  .sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)) || String(a.business_name || "").localeCompare(String(b.business_name || "")));
const cityBusinessSlugs = new Set(cityBusinesses.map((business) => business.slug).filter(Boolean));

const currentEvents = getCurrentEvents(allEvents)
  .map((event) => withResolvedEventLocation(event, businessIndex))
  .map((event) => ({ ...event, next_occurrence_date: getNextOccurrenceDate(event) }));
const cityEvents = currentEvents
  .filter((event) => {
    if (recordDirectlyReferencesCity(event)) return true;
    return getEventVenueSlugs(event).some((slug) => cityBusinessSlugs.has(slug)) || cityBusinessSlugs.has(event.host_business_slug);
  })
  .sort((a, b) => {
    const dateComparison = eventSortDate(a).localeCompare(eventSortDate(b));
    if (dateComparison !== 0) return dateComparison;
    return new Date(a.start_datetime || "9999-12-31").getTime() - new Date(b.start_datetime || "9999-12-31").getTime();
  });

const timeZoneLabels = (entity.time_zones ?? []).map((zone) => zone === "America/Chicago" ? "Central Time" : zone === "America/Denver" ? "Mountain Time" : zone);
const publishedBusinessSlugs = new Set(
  allBusinesses.filter((business) => business.publish_ready === true).map((business) => business.slug).filter(Boolean)
);
const relatedGeographies = [
  ...(entity.related_geography_slugs ?? []),
  ...(entity.nearby_city_slugs ?? [])
]
  .map((slug) => allGeography.find((item) => item.publish_ready === true && item.slug === slug))
  .filter(Boolean);
const relatedBusinessSlugs = (entity.related_geography_slugs ?? []).filter((slug) => publishedBusinessSlugs.has(slug));
const geographyHref = (item) => {
  if (!item?.slug) return null;
  if (item.entity_type === "state") return `/states/${item.slug}/`;
  if (item.entity_type === "county") return `/counties/${item.slug}/`;
  if (item.entity_type === "city") return `/cities/${item.slug}/`;
  if (item.entity_type === "region") return `/regions/${item.slug}/`;
  return null;
};

const pageTitle = entity.seo_title || `${entity.name}, ${state?.abbreviation || state?.name || ""} | Texoma Weekend Guide`;
const pageDescription = entity.seo_description || entity.short_description || entity.description;
const siteURL = Astro.site ?? new URL("https://texomaweekendguide.com");
const cityURL = new URL(`/cities/${entity.slug}/`, siteURL);
const breadcrumbItems = [
  ...(state ? [{ name: state.name, url: `/states/${state.slug}/` }] : []),
  ...(county ? [{ name: county.name, url: `/counties/${county.slug}/` }] : []),
  { name: entity.name, url: `/cities/${entity.slug}/` }
];
const breadcrumbJsonLdText = serializeJsonLd(buildBreadcrumbJsonLd({ items: breadcrumbItems, siteUrl: siteURL }));
const cityJsonLdText = serializeJsonLd({
  "@context": "https://schema.org",
  "@type": "City",
  "@id": `${cityURL.href}#place`,
  name: entity.name,
  url: cityURL.href,
  description: pageDescription,
  ...(Number.isFinite(entity.latitude) && Number.isFinite(entity.longitude) && entity.coordinate_status === "verified" ? {
    geo: {
      "@type": "GeoCoordinates",
      latitude: entity.latitude,
      longitude: entity.longitude
    }
  } : {}),
  ...(county ? {
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: county.name,
      url: new URL(`/counties/${county.slug}/`, siteURL).href
    }
  } : state ? {
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: state.name,
      url: new URL(`/states/${state.slug}/`, siteURL).href
    }
  } : {}),
  ...(entity.official_website_url ? { sameAs: [entity.official_website_url] } : {})
});

const featuredBusinesses = cityBusinesses.slice(0, 6);
const upcomingEvents = cityEvents.slice(0, 8);
const supportingMedia = [
  ...(heroSecondary?.url ? [{ ...heroSecondary, label: "City landmark" }] : []),
  ...gallery.map((asset) => ({ ...asset, label: `Around ${entity.name}` }))
].slice(0, 4);
---

<BaseLayout title={pageTitle} description={pageDescription} image={heroPrimary?.url || undefined}>
  {breadcrumbJsonLdText && <script type="application/ld+json" set:html={breadcrumbJsonLdText} />}
  {cityJsonLdText && <script type="application/ld+json" set:html={cityJsonLdText} />}

  <article class="city-page">
    <header class="city-hero">
      {heroPrimary?.url && <img class="hero-image" src={heroPrimary.url} alt={heroPrimary.alt_text || `${entity.name} city view`} />}
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span>›</span>
          {state && <><a href={`/states/${state.slug}/`}>{state.name}</a><span>›</span></>}
          {county && <><a href={`/counties/${county.slug}/`}>{county.name}</a><span>›</span></>}
          <span>{entity.name}</span>
        </nav>
        <p class="eyebrow">{county?.name || state?.name || "Texoma"} · City guide</p>
        <h1>{entity.name}</h1>
        {entity.short_description && <p class="hero-summary">{entity.short_description}</p>}
        <div class="hero-actions">
          <a class="button primary" href="#explore">Explore {entity.name}</a>
          <a class="button ghost" href="#upcoming-events">Upcoming events</a>
        </div>
      </div>
    </header>

    <main class="container content-wrap">
      <section class="intro-grid">
        <div class="intro-copy card">
          <p class="section-label">About {entity.name}</p>
          <h2>{entity.visitor_summary || `Discover ${entity.name}`}</h2>
          <p>{entity.description}</p>
          {entity.history_summary && <p>{entity.history_summary}</p>}
          {entity.coverage_notes && <div class="coverage-note"><strong>TWG coverage:</strong> {entity.coverage_notes}</div>}
        </div>

        <aside class="quick-facts card">
          <h2>{entity.name} at a glance</h2>
          <dl>
            {state && <><dt>State</dt><dd><a href={`/states/${state.slug}/`}>{state.name}</a></dd></>}
            {county && <><dt>County</dt><dd><a href={`/counties/${county.slug}/`}>{county.name}</a></dd></>}
            {entity.founded_date && <><dt>Founded</dt><dd>{formatDate(entity.founded_date)}</dd></>}
            {entity.incorporated_date && <><dt>Incorporated</dt><dd>{formatDate(entity.incorporated_date)}</dd></>}
            {entity.population?.value && <><dt>Population</dt><dd>{formatNumber(entity.population.value)} <small>({entity.population.year} {entity.population.type})</small></dd></>}
            {entity.area_land_sq_mi && <><dt>Land area</dt><dd>{formatNumber(entity.area_land_sq_mi)} sq. mi.</dd></>}
            {entity.postal_codes?.length > 0 && <><dt>ZIP codes</dt><dd>{entity.postal_codes.join(", ")}</dd></>}
            {entity.fips_code && <><dt>FIPS code</dt><dd>{entity.fips_code}</dd></>}
            {timeZoneLabels.length > 0 && <><dt>Time zone</dt><dd>{timeZoneLabels.join(" and ")}</dd></>}
          </dl>
          {entity.official_website_url && <a class="text-link" href={entity.official_website_url} target="_blank" rel="noopener noreferrer">Official city website →</a>}
        </aside>
      </section>

      {(locatorMap?.url || supportingMedia.length > 0) && (
        <section class="visual-section">
          <div class="section-heading">
            <p class="section-label">See {entity.name}</p>
            <h2>Location, landmarks and local character</h2>
          </div>
          <div class="visual-grid">
            {locatorMap?.url && (
              <figure class="visual-card card locator-card">
                <div class="visual-frame map-frame"><img src={locatorMap.url} alt={locatorMap.alt_text || `Map showing ${entity.name} in ${county?.name || state?.name || "the region"}`} loading="lazy" /></div>
                <figcaption><strong>Where {entity.name} is</strong>{locatorMap.credit && <span>{locatorMap.credit}</span>}</figcaption>
              </figure>
            )}
            {supportingMedia.map((asset) => (
              <figure class="visual-card card">
                <div class="visual-frame"><img src={asset.url} alt={asset.alt_text || entity.name} loading="lazy" /></div>
                <figcaption><strong>{asset.label}</strong>{asset.credit && <span>{asset.credit}</span>}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <section id="explore" class="explore-section">
        <div class="section-heading">
          <p class="section-label">Explore through TWG</p>
          <h2>Discover more around {entity.name}</h2>
          <p>{entity.visitor_summary || `Use Texoma Weekend Guide to find current events, restaurants, venues, parks, attractions and local businesses in ${entity.name}.`}</p>
        </div>
        <div class="stat-grid">
          <a class="stat-card" href="#upcoming-events"><strong>{formatNumber(cityEvents.length) || "0"}</strong><span>current events</span></a>
          <a class="stat-card" href="#featured-places"><strong>{formatNumber(cityBusinesses.length) || "0"}</strong><span>businesses and venues</span></a>
          {county ? <a class="stat-card geography-stat" href={`/counties/${county.slug}/`}><strong>{county.name}</strong><span>county guide</span></a> : <div class="stat-card geography-stat"><strong>{state?.name || "Texoma"}</strong><span>region</span></div>}
          <div class="stat-card geography-stat"><strong>{entity.population?.value ? formatNumber(entity.population.value) : state?.abbreviation || "TX"}</strong><span>{entity.population?.value ? `${entity.population.year} population` : "state"}</span></div>
        </div>
      </section>

      {upcomingEvents.length > 0 && (
        <section id="upcoming-events" class="city-section">
          <div class="section-heading">
            <p class="section-label">What’s happening</p>
            <h2>Upcoming events in {entity.name}</h2>
            <p>These listings are pulled from the current TWG event directory and resolved through their city and venue relationships.</p>
          </div>
          <div class="event-grid">
            {upcomingEvents.map((event) => (
              <a class="event-card card" href={`/events/${event.event_slug}/`}>
                {event.image_url && <img src={event.image_url} alt={event.image_alt || `${event.event_name} event image`} loading="lazy" />}
                <div>
                  <span class="event-date">{eventDisplayDate(event)}</span>
                  <strong>{event.event_name}</strong>
                  {(event.venue_name || event.city) && <p>{event.venue_name}{event.city ? `${event.venue_name ? " · " : ""}${event.city}` : ""}</p>}
                  {event.start_datetime && <small>{formatEventTime(event.start_datetime)}{event.end_datetime ? `–${formatEventTime(event.end_datetime)}` : ""}</small>}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {featuredBusinesses.length > 0 && (
        <section id="featured-places" class="city-section">
          <div class="section-heading">
            <p class="section-label">Places to explore</p>
            <h2>Restaurants, venues, parks and local destinations</h2>
            <p>A sample of published TWG listings currently associated with {entity.name}.</p>
          </div>
          <div class="place-grid">
            {featuredBusinesses.map((business) => {
              const image = business.image_url || business.logo_url || business.gallery?.[0]?.url || null;
              const category = business.primary_category || business.categories?.[0] || business.category?.[0] || business.category || "Local listing";
              return (
                <a class="place-card card" href={`/businesses/${business.slug}/`}>
                  {image && <img src={image} alt="" loading="lazy" />}
                  <div><span>{category}</span><strong>{business.business_name}</strong>{business.city && <p>{business.city}, {business.state}</p>}</div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {(county || relatedGeographies.length > 0 || relatedBusinessSlugs.length > 0) && (
        <section class="city-section related-section">
          <div class="section-heading">
            <p class="section-label">Connected destinations</p>
            <h2>Nearby and overlapping geography</h2>
          </div>
          <div class="related-links">
            {county && <a href={`/counties/${county.slug}/`}>{county.name}</a>}
            {relatedGeographies.map((item) => {
              const href = geographyHref(item);
              return href ? <a href={href}>{item.name}</a> : null;
            })}
            {relatedBusinessSlugs.map((slug) => {
              const business = businessIndex.get(slug);
              return business ? <a href={`/businesses/${slug}/`}>{business.business_name}</a> : null;
            })}
          </div>
        </section>
      )}

      {sourceEntries.length > 0 && (
        <section class="sources card">
          <h2>Sources and verification</h2>
          <ul>{sourceEntries.map((source) => <li>{source.source_url ? <a href={source.source_url} target="_blank" rel="noopener noreferrer">{source.source_name}</a> : source.source_name}{source.notes && <span> — {source.notes}</span>}</li>)}</ul>
          {entity.last_verified && <p class="verified">Last verified {formatDate(entity.last_verified)}.</p>}
        </section>
      )}
    </main>
  </article>
</BaseLayout>

<style>
  .city-page{background:#f7f3ea;color:#24333c;min-height:100vh}.city-hero{position:relative;min-height:clamp(500px,68vh,760px);display:flex;align-items:end;overflow:hidden;background:#103a58}.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,24,37,.18) 10%,rgba(6,24,37,.88) 100%)}.hero-content{position:relative;z-index:1;padding-block:2rem 4rem;color:white}.breadcrumb{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:2rem;font-weight:750}.breadcrumb a{color:white}.eyebrow,.section-label{margin:0 0 .55rem;color:#48a9bd;font-size:.83rem;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.city-hero h1{margin:0;color:white;font-size:clamp(3.7rem,13vw,8rem);line-height:.9;letter-spacing:-.05em}.hero-summary{max-width:800px;margin:1.2rem 0 0;color:white;font-size:clamp(1.15rem,2.2vw,1.55rem);line-height:1.5}.hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.6rem}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.75rem 1rem;border-radius:.75rem;font-weight:900;text-decoration:none}.button.primary{background:#1d87a4;color:white}.button.ghost{border:1px solid rgba(255,255,255,.65);background:rgba(255,255,255,.1);color:white}.content-wrap{padding-block:2.5rem 5rem}.card{border:1px solid #d8e0df;border-radius:1.05rem;background:#fffdf8;box-shadow:0 12px 30px rgba(16,58,88,.07)}.intro-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:1.25rem}.intro-copy,.quick-facts,.sources{padding:clamp(1.25rem,3vw,2rem)}h2{margin:.1rem 0 1rem;color:#103a58;font-size:clamp(1.7rem,3.5vw,2.55rem);line-height:1.1}.intro-copy>p:not(.section-label){font-size:1.08rem;line-height:1.75}.coverage-note{margin-top:1.25rem;padding:1rem;border-left:5px solid #1d87a4;background:#edf7f8;border-radius:.55rem}.quick-facts dl{display:grid;grid-template-columns:minmax(120px,.7fr) minmax(0,1.3fr);gap:.75rem 1rem;margin:0}.quick-facts dt{font-weight:900;color:#103a58}.quick-facts dd{margin:0;overflow-wrap:anywhere}.quick-facts dd a,.text-link{color:#176f95;font-weight:800}.quick-facts small{color:#5e7078}.text-link{display:inline-block;margin-top:1.2rem}.visual-section,.explore-section,.city-section{margin-top:3.5rem}.section-heading{max-width:820px;margin-bottom:1.35rem}.section-heading>p:not(.section-label){line-height:1.65}.visual-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.visual-card{overflow:hidden;margin:0}.visual-frame{height:330px;background:white}.visual-frame img{display:block;width:100%;height:100%;object-fit:cover}.map-frame img{object-fit:contain;padding:1rem}.visual-card figcaption{display:flex;flex-direction:column;gap:.25rem;padding:1rem;border-top:1px solid #d8e0df}.visual-card figcaption span{font-size:.85rem;color:#687981}.stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.stat-card{display:flex;flex-direction:column;gap:.35rem;padding:1.3rem;border-radius:1rem;background:#103a58;color:white;text-decoration:none}.stat-card strong{font-size:2.2rem;line-height:1}.geography-stat strong{font-size:1.25rem;line-height:1.2}.stat-card span{color:#d6edf2;font-weight:750}.place-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.place-card{overflow:hidden;color:inherit;text-decoration:none}.place-card img{display:block;width:100%;height:180px;object-fit:cover}.place-card>div{padding:1.2rem}.place-card span,.event-date{color:#1d87a4;font-size:.8rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.place-card strong{display:block;margin:.25rem 0;color:#103a58;font-size:1.4rem}.place-card p{margin:.45rem 0;line-height:1.5}.event-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.event-card{display:grid;grid-template-columns:150px minmax(0,1fr);overflow:hidden;color:inherit;text-decoration:none}.event-card>img{width:100%;height:100%;min-height:180px;object-fit:cover}.event-card>div{padding:1.2rem}.event-card strong{display:block;margin:.25rem 0;color:#103a58;font-size:1.25rem}.event-card p{margin:.4rem 0;line-height:1.45}.event-card small{color:#687981;font-weight:750}.related-section{padding:1.5rem;border:1px solid #cfe0df;border-radius:1rem;background:#eaf5f4}.related-links{display:flex;flex-wrap:wrap;gap:.75rem}.related-links a{padding:.75rem 1rem;border-radius:.7rem;background:white;color:#176f95;font-weight:900;text-decoration:none}.sources{margin-top:3.5rem}.sources ul{padding-left:1.2rem}.sources li+li{margin-top:.75rem}.sources a{color:#176f95;font-weight:800}.verified{color:#687981;font-style:italic}@media(max-width:900px){.intro-grid{grid-template-columns:1fr}.stat-grid{grid-template-columns:1fr 1fr}.place-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.event-grid{grid-template-columns:1fr}}@media(max-width:620px){.hero-content{padding-bottom:2.7rem}.visual-grid,.place-grid,.stat-grid{grid-template-columns:1fr}.quick-facts dl{grid-template-columns:1fr;gap:.2rem}.quick-facts dd{margin-bottom:.65rem}.visual-frame{height:260px}.event-card{grid-template-columns:1fr}.event-card>img{height:220px;min-height:0}}
</style>
