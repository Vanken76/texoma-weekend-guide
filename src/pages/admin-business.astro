---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Business Publisher | Texoma Weekend Guide"
  description="Private single-business publishing utility for the Texoma Weekend Guide directory."
>
  <section class="publisher">
    <header>
      <p class="eyebrow">TWG Admin</p>
      <h1>Single-Business Publisher</h1>
      <p>Load an existing business by slug or paste one business record, optionally attach its official logo, then validate and publish. The publisher adds or replaces the matching slug in the directory and stores the logo with the website files.</p>
    </header>

    <section class="panel auth-panel">
      <label for="admin-key">Admin key</label>
      <input id="admin-key" type="password" autocomplete="current-password" placeholder="Enter your private publishing key" />
      <p class="helper">The key is saved only for this browser tab.</p>
    </section>

    <section class="panel tool-panel">
      <label for="existing-business-slug">Load existing business by slug</label>
      <div class="load-row">
        <input id="existing-business-slug" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="Example: the-post-sherman" />
        <button id="load-existing" class="secondary-action" type="button">Load Business</button>
      </div>
      <p class="helper">Loads the complete current business object into the editor so you can update a logo, photos, details, or other fields without rebuilding the JSON.</p>

      <label for="business-json">Business JSON</label>
      <textarea id="business-json" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder='Paste one business object here, beginning with { and ending with }'></textarea>

      <label for="business-logo">Business logo <span class="optional">optional</span></label>
      <input id="business-logo" type="file" accept="image/jpeg,image/png,image/webp" />
      <p class="helper">JPG, PNG, or WebP. Maximum 4 MB. The file will be saved as <code>/images/businesses/[slug]-logo.ext</code> and its URL will be added to the business record automatically.</p>
      <div id="logo-preview-wrap" class="logo-preview-wrap" hidden>
        <img id="logo-preview" alt="Selected business logo preview" />
        <div>
          <p id="logo-name" class="logo-name"></p>
          <button id="clear-logo" class="secondary-action" type="button">Remove selected logo</button>
        </div>
      </div>

      <label for="remove-slugs">Old duplicate slug(s) to remove <span class="optional">optional</span></label>
      <input id="remove-slugs" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="Example: the-milieu" />
      <p class="helper">Separate multiple old slugs with commas. The new business slug will never be removed.</p>

      <div class="actions">
        <button id="validate" type="button">Validate Business</button>
        <button id="publish" type="button" disabled>Publish Business</button>
      </div>

      <section class="results" aria-live="polite">
        <h2>Business status</h2>
        <p id="status">Nothing has been validated yet.</p>
        <ul id="checks"></ul>
      </section>
    </section>
  </section>

  <script>
    const adminKey = document.querySelector("#admin-key");
    const existingBusinessSlugInput = document.querySelector("#existing-business-slug");
    const loadExistingButton = document.querySelector("#load-existing");
    const businessInput = document.querySelector("#business-json");
    const logoInput = document.querySelector("#business-logo");
    const logoPreviewWrap = document.querySelector("#logo-preview-wrap");
    const logoPreview = document.querySelector("#logo-preview");
    const logoName = document.querySelector("#logo-name");
    const clearLogoButton = document.querySelector("#clear-logo");
    const removeSlugsInput = document.querySelector("#remove-slugs");
    const validateButton = document.querySelector("#validate");
    const publishButton = document.querySelector("#publish");
    const status = document.querySelector("#status");
    const checks = document.querySelector("#checks");

    if (
      !(adminKey instanceof HTMLInputElement) ||
      !(existingBusinessSlugInput instanceof HTMLInputElement) ||
      !(loadExistingButton instanceof HTMLButtonElement) ||
      !(businessInput instanceof HTMLTextAreaElement) ||
      !(logoInput instanceof HTMLInputElement) ||
      !(logoPreviewWrap instanceof HTMLElement) ||
      !(logoPreview instanceof HTMLImageElement) ||
      !(logoName instanceof HTMLElement) ||
      !(clearLogoButton instanceof HTMLButtonElement) ||
      !(removeSlugsInput instanceof HTMLInputElement) ||
      !(validateButton instanceof HTMLButtonElement) ||
      !(publishButton instanceof HTMLButtonElement) ||
      !(status instanceof HTMLElement) ||
      !(checks instanceof HTMLUListElement)
    ) {
      throw new Error("Business publisher controls could not be initialized.");
    }

    const MAX_LOGO_BYTES = 4 * 1024 * 1024;
    const ALLOWED_LOGO_TYPES = new Set(["image/jpeg", "image/png", "image/webp"]);
    const savedKey = sessionStorage.getItem("twg-admin-key");
    if (savedKey) adminKey.value = savedKey;
    adminKey.addEventListener("input", () => {
      if (adminKey.value) sessionStorage.setItem("twg-admin-key", adminKey.value);
      else sessionStorage.removeItem("twg-admin-key");
    });

    let validatedBusiness = null;
    let selectedLogo = null;
    let previewUrl = null;
    let businessDirectoryCache = null;

    const setResult = (message, items = [], valid = false) => {
      status.textContent = message;
      status.className = valid ? "success" : "error";
      checks.replaceChildren();
      for (const item of items) {
        const li = document.createElement("li");
        li.textContent = item;
        checks.appendChild(li);
      }
    };

    const invalidate = () => {
      validatedBusiness = null;
      publishButton.disabled = true;
    };

    const clearLogo = () => {
      selectedLogo = null;
      logoInput.value = "";
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = null;
      logoPreview.removeAttribute("src");
      logoName.textContent = "";
      logoPreviewWrap.hidden = true;
      invalidate();
    };

    const validateLogoFile = (file) => {
      if (!ALLOWED_LOGO_TYPES.has(file.type)) return "Logo must be a JPG, PNG, or WebP image.";
      if (file.size > MAX_LOGO_BYTES) return "Logo must be 4 MB or smaller.";
      return null;
    };

    const fileToBase64 = (file) => new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const result = typeof reader.result === "string" ? reader.result : "";
        const commaIndex = result.indexOf(",");
        if (commaIndex < 0) reject(new Error("The logo could not be encoded."));
        else resolve(result.slice(commaIndex + 1));
      };
      reader.onerror = () => reject(new Error("The logo could not be read."));
      reader.readAsDataURL(file);
    });

    logoInput.addEventListener("change", () => {
      const file = logoInput.files?.[0] || null;
      if (!file) {
        clearLogo();
        return;
      }
      const problem = validateLogoFile(file);
      if (problem) {
        clearLogo();
        setResult(problem, [], false);
        return;
      }
      selectedLogo = file;
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(file);
      logoPreview.src = previewUrl;
      logoName.textContent = `${file.name} · ${(file.size / 1024).toFixed(0)} KB`;
      logoPreviewWrap.hidden = false;
      invalidate();
    });
    clearLogoButton.addEventListener("click", clearLogo);

    const validateBusiness = () => {
      validatedBusiness = null;
      publishButton.disabled = true;

      try {
        const business = JSON.parse(businessInput.value);
        const problems = [];

        if (!business || typeof business !== "object" || Array.isArray(business)) {
          throw new Error("The business must be one JSON object, not an array or full directory.");
        }
        if (!business.business_name || typeof business.business_name !== "string") problems.push("business_name is required.");
        if (!business.slug || typeof business.slug !== "string") problems.push("slug is required.");
        else if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(business.slug)) problems.push("slug must use lowercase letters, numbers, and single hyphens only.");
        if (business.publish_ready !== true) problems.push("publish_ready must be true before publishing.");
        if (selectedLogo) {
          const logoProblem = validateLogoFile(selectedLogo);
          if (logoProblem) problems.push(logoProblem);
        }

        if (problems.length) {
          setResult("Business validation found problems.", problems, false);
          return false;
        }

        validatedBusiness = business;
        publishButton.disabled = false;
        const oldSlugs = removeSlugsInput.value.split(",").map((slug) => slug.trim()).filter(Boolean);
        const items = [
          `Business: ${business.business_name}`,
          `Slug: ${business.slug}`,
          "Publish-ready: yes",
          selectedLogo ? `Logo selected: ${selectedLogo.name}` : business.logo_url ? `Existing logo retained: ${business.logo_url}` : "No logo selected",
          oldSlugs.length ? `Old slug(s) marked for removal: ${oldSlugs.join(", ")}` : "No old duplicate slugs marked for removal"
        ];
        setResult("Valid business JSON. It is ready to publish.", items, true);
        return true;
      } catch (error) {
        const message = error instanceof Error ? error.message : "Unknown validation error.";
        setResult(`Invalid JSON: ${message}`, [], false);
        return false;
      }
    };

    const loadExistingBusiness = async () => {
      const slug = existingBusinessSlugInput.value.trim().toLowerCase();
      if (!slug) {
        setResult("Enter a business slug to load.", [], false);
        existingBusinessSlugInput.focus();
        return;
      }

      loadExistingButton.disabled = true;
      loadExistingButton.textContent = "Loading…";
      setResult(`Loading ${slug}…`, [], true);

      try {
        if (!businessDirectoryCache) {
          const response = await fetch(`/data/local-business-directory.json?admin_load=${Date.now()}`, { cache: "no-store" });
          if (!response.ok) throw new Error(`The business directory could not be loaded (${response.status}).`);
          const directory = await response.json();
          if (!directory || !Array.isArray(directory.businesses)) throw new Error("The business directory response is missing its businesses array.");
          businessDirectoryCache = directory.businesses;
        }

        const business = businessDirectoryCache.find((record) => record?.slug === slug);
        if (!business) {
          setResult(`No business found with slug: ${slug}`, ["Check the slug and try again. Newly published records may need to finish deploying before they can be loaded here."], false);
          return;
        }

        if (selectedLogo) clearLogo();
        removeSlugsInput.value = "";
        businessInput.value = JSON.stringify(business, null, 2);
        const valid = validateBusiness();
        if (valid) status.textContent = `Loaded ${business.business_name}. The complete current object is ready to edit.`;
      } catch (error) {
        const message = error instanceof Error ? error.message : "Unknown loading error.";
        setResult(`Could not load the business: ${message}`, [], false);
      } finally {
        loadExistingButton.disabled = false;
        loadExistingButton.textContent = "Load Business";
      }
    };

    loadExistingButton.addEventListener("click", loadExistingBusiness);
    existingBusinessSlugInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        loadExistingBusiness();
      }
    });

    businessInput.addEventListener("input", invalidate);
    removeSlugsInput.addEventListener("input", () => {
      if (validatedBusiness) validateBusiness();
    });
    validateButton.addEventListener("click", validateBusiness);

    publishButton.addEventListener("click", async () => {
      if (!validatedBusiness && !validateBusiness()) return;
      if (!adminKey.value) {
        setResult("Enter the admin key before publishing.", [], false);
        adminKey.focus();
        return;
      }

      const removeSlugs = removeSlugsInput.value.split(",").map((slug) => slug.trim()).filter(Boolean);
      publishButton.disabled = true;
      publishButton.textContent = selectedLogo ? "Uploading logo and publishing…" : "Publishing…";

      try {
        const logo = selectedLogo ? {
          name: selectedLogo.name,
          type: selectedLogo.type,
          size: selectedLogo.size,
          data: await fileToBase64(selectedLogo)
        } : null;

        const response = await fetch("/api/publish-business", {
          method: "POST",
          headers: { "content-type": "application/json", "x-admin-key": adminKey.value },
          body: JSON.stringify({ business: validatedBusiness, remove_slugs: removeSlugs, logo })
        });
        const result = await response.json();
        if (!response.ok) {
          setResult(result.error || `Publishing failed with status ${response.status}.`, Array.isArray(result.problems) ? result.problems : [], false);
          return;
        }

        if (result.logo_url) {
          validatedBusiness.logo_url = result.logo_url;
          validatedBusiness.logo_alt = `${validatedBusiness.business_name} logo`;
          businessInput.value = JSON.stringify(validatedBusiness, null, 2);
        }

        setResult(result.message || "Business published successfully.", [
          `${result.business_count} total businesses now stored`,
          `${result.publish_ready_count} publish-ready businesses now stored`,
          result.logo_url ? `Logo saved: ${result.logo_url}` : "No new logo uploaded",
          result.removed_count ? `${result.removed_count} old duplicate record(s) removed` : "No old duplicate records removed",
          result.commit ? `GitHub commit: ${result.commit.slice(0, 7)}` : "GitHub commit created"
        ], true);
      } catch (error) {
        const message = error instanceof Error ? error.message : "Unknown publishing error.";
        setResult(`Publishing failed: ${message}`, [], false);
      } finally {
        publishButton.disabled = !validatedBusiness;
        publishButton.textContent = "Publish Business";
      }
    });
  </script>
</BaseLayout>

<style>
  .publisher { width: min(760px, calc(100% - 2rem)); margin: 0 auto; padding: 3rem 0 5rem; }
  header { margin-bottom: 1.5rem; }
  .eyebrow { margin: 0 0 0.35rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  h1, h2 { margin-top: 0; }
  h1 { margin-bottom: 0.75rem; }
  .panel { padding: 1.25rem; border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 1rem; background: rgba(255, 255, 255, 0.05); }
  .tool-panel { margin-top: 1.25rem; }
  label { display: block; margin: 0.9rem 0 0.5rem; font-weight: 800; }
  input, textarea { width: 100%; padding: 0.9rem; border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 0.65rem; font: inherit; }
  input[type="file"] { padding: 0.65rem; }
  textarea { min-height: 48vh; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.82rem; line-height: 1.45; }
  code { font-size: 0.86em; }
  .helper { margin: 0.5rem 0 0; font-size: 0.9rem; opacity: 0.78; }
  .optional { font-weight: 400; opacity: 0.7; }
  .load-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.75rem; align-items: stretch; }
  .load-row button { white-space: nowrap; }
  .logo-preview-wrap { display: flex; gap: 1rem; align-items: center; margin-top: 0.85rem; padding: 0.8rem; border: 1px solid rgba(255,255,255,.16); border-radius: .75rem; }
  .logo-preview-wrap[hidden] { display: none; }
  .logo-preview-wrap img { width: 112px; height: 112px; object-fit: contain; border-radius: .5rem; background: white; }
  .logo-name { margin: 0 0 .65rem; font-weight: 800; overflow-wrap: anywhere; }
  .secondary-action { background: transparent; border: 1px solid rgba(255,255,255,.25); color: inherit; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
  button { min-height: 44px; padding: 0.7rem 1rem; border: 0; border-radius: 0.6rem; font: inherit; font-weight: 800; cursor: pointer; }
  button:disabled { cursor: not-allowed; opacity: 0.45; }
  .results { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .results h2 { margin-bottom: 0.5rem; font-size: 1.05rem; }
  .results ul { margin-bottom: 0; }
  .success, .error { font-weight: 800; }
  @media (max-width: 640px) {
    .publisher { padding-top: 1.5rem; }
    .panel { padding: 0.85rem; }
    textarea { min-height: 58vh; }
    .load-row { grid-template-columns: 1fr; }
    .load-row button, .actions button { flex: 1 1 100%; width: 100%; }
    .logo-preview-wrap { align-items: flex-start; }
    .logo-preview-wrap img { width: 88px; height: 88px; }
  }
</style>
