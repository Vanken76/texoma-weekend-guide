---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import eventDirectory from "../../public/data/local-event-directory.json";

const roundups = (await getCollection("roundups")).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);

const latestRoundup = roundups[0];

const now = new Date();
const today = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Chicago",
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(now);

const parseRule = (rule = "") => Object.fromEntries(
  rule.split(";").map((part) => part.split("=")).filter(([key, value]) => key && value)
);

const recurrenceEndDate = (event) => {
  if (event.recurrence_end_date) return event.recurrence_end_date;
  const until = parseRule(event.recurrence_rule).UNTIL;
  if (!until || !/^\d{8}/.test(until)) return null;
  return `${until.slice(0, 4)}-${until.slice(4, 6)}-${until.slice(6, 8)}`;
};

const isCurrent = (event) => {
  if (event.active === false) return false;
  if (event.recurring === true) {
    const endDate = recurrenceEndDate(event);
    return !endDate || endDate >= today;
  }
  if (event.end_datetime) return new Date(event.end_datetime) >= now;
  return Boolean(event.start_datetime && event.start_datetime.slice(0, 10) >= today);
};

const events = (eventDirectory.events ?? [])
  .filter((event) => event.publish_ready === true)
  .filter((event) => ["upcoming", "recurring"].includes(event.status))
  .filter(isCurrent);

const includesTerm = (event, term) => [
  ...(event.categories ?? []),
  ...(event.tags ?? []),
  ...(event.audience ?? [])
].some((value) => String(value).toLowerCase().includes(term));

const venueSlugs = new Set(
  events.flatMap((event) => [
    ...(Array.isArray(event.venue_slugs) ? event.venue_slugs : []),
    event.venue_slug,
    event.host_business_slug
  ]).filter(Boolean)
);

const stats = [
  { value: events.length, label: "Upcoming Events", href: "/events/" },
  { value: events.filter((event) => event.cost_type === "free").length, label: "Free Events", href: "/events/?filter=free" },
  { value: events.filter((event) => includesTerm(event, "live music")).length, label: "Live Music", href: "/events/?filter=live%20music" },
  { value: events.filter((event) => includesTerm(event, "family")).length, label: "Family-Friendly", href: "/events/?filter=family" },
  { value: events.filter((event) => event.recurring === true).length, label: "Recurring Events", href: "/events/?when=recurring" },
  { value: venueSlugs.size, label: "Event Venues", href: "/businesses/" }
];
---

<BaseLayout title="Texoma Weekend Guide | Discover Local. Make Memories.">
  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">Texas · Oklahoma · Lake Texoma</p>

      <h1>
        Discover Local.
        <br />
        Make Memories.
      </h1>

      <p class="hero-copy">
        Your guide to events, live music, food, lake days, family fun,
        and local businesses across Texoma.
      </p>

      <div class="button-row">
        <a class="button" href="/roundups/">
          See the Weekend Roundup
        </a>

        <a class="button secondary" href="/submit/">
          Submit an Event
        </a>
      </div>
    </div>
  </section>

  <section class="directory-stats" aria-labelledby="directory-stats-heading">
    <div class="container">
      <div class="stats-heading">
        <p class="eyebrow">Explore what’s happening now</p>
        <h2 id="directory-stats-heading">The Texoma calendar is growing</h2>
        <p>Live totals from the current public event directory.</p>
      </div>

      <div class="stats-grid">
        {stats.map((stat) => (
          <a class="stat-card" href={stat.href} aria-label={`Browse ${stat.label}`}>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Plan your weekend</p>
        <h2>What’s happening around Texoma?</h2>

        <p>
          From Denison and Sherman to Durant, Gainesville, Bonham,
          Lake Texoma, and the communities in between.
        </p>
      </div>

      <div class="feature-grid">
        <a class="feature" href="/events/?filter=live%20music" aria-label="Browse live music events">
          <span aria-hidden="true">🎶</span>
          <h3>Live Music</h3>
          <p>
            Local performers, concerts, karaoke, open mics,
            and nightlife.
          </p>
        </a>

        <a class="feature" href="/events/?filter=family" aria-label="Browse family fun events">
          <span aria-hidden="true">🎡</span>
          <h3>Family Fun</h3>
          <p>
            Festivals, carnivals, markets, children’s events,
            and free activities.
          </p>
        </a>

        <a class="feature" href="/events/?filter=food" aria-label="Browse food and local events">
          <span aria-hidden="true">🍽️</span>
          <h3>Food & Local Stops</h3>
          <p>
            Restaurants, specials, fundraisers, small businesses,
            and hidden gems.
          </p>
        </a>

        <a class="feature" href="/events/?filter=lake" aria-label="Browse lake and outdoor events">
          <span aria-hidden="true">🌊</span>
          <h3>Lake Days</h3>
          <p>
            Parks, outdoor programs, lake activities, trails,
            and seasonal recreation.
          </p>
        </a>
      </div>
    </div>
  </section>

  {latestRoundup && (
    <section class="section latest">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Latest guide</p>
          <h2>{latestRoundup.data.title}</h2>
          <p>{latestRoundup.data.description}</p>
        </div>

        <article class="roundup-feature card">
          <img
            src={latestRoundup.data.image}
            alt={latestRoundup.data.title}
          />

          <div class="card-content">
            <h3>Start planning your Texoma weekend</h3>

            <p>
              Browse the latest roundup for events, live music,
              family fun, food, and community activities.
            </p>

            <a
              class="button"
              href={`/roundups/${latestRoundup.id}/`}
            >
              Read the Roundup
            </a>
          </div>
        </article>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container callout">
      <p class="eyebrow">Organizers and local businesses</p>
      <h2>Have something happening around Texoma?</h2>

      <p>
        Send the date, time, location, event details, flyer,
        and official link. Submissions are free and considered
        based on local relevance and available space.
      </p>

      <div class="button-row">
        <a class="button secondary" href="/submit/">
          Submit Your Event
        </a>

        <a
          class="button secondary"
          href="mailto:texomaweekendguide@gmail.com"
        >
          Email TWG
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 670px;
    display: flex;
    align-items: center;
    background:
      linear-gradient(
        90deg,
        rgba(10, 42, 63, 0.95) 0%,
        rgba(10, 42, 63, 0.78) 57%,
        rgba(10, 42, 63, 0.32) 100%
      ),
      url("/images/banner.jpg") center / cover;
    color: white;
  }

  .hero-content {
    padding-block: 5rem;
  }

  .hero h1,
  .hero p {
    color: white;
  }

  .hero-copy {
    max-width: 700px;
    font-size: clamp(1.1rem, 2.4vw, 1.38rem);
  }

  .directory-stats {
    padding: 3.5rem 0;
    background: #e9f3f2;
    border-bottom: 1px solid #d2e4e2;
  }

  .stats-heading {
    max-width: 760px;
    margin-bottom: 1.5rem;
  }

  .stats-heading h2 {
    margin-bottom: 0.45rem;
  }

  .stats-heading p:last-child {
    margin-bottom: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .stat-card {
    min-height: 128px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border: 1px solid #c9dcda;
    border-radius: 16px;
    background: white;
    color: #0a2a3f;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(16, 58, 88, 0.08);
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .stat-card:hover,
  .stat-card:focus-visible {
    transform: translateY(-3px);
    border-color: #176f95;
    box-shadow: 0 13px 30px rgba(16, 58, 88, 0.14);
  }

  .stat-card:focus-visible {
    outline: 3px solid rgba(23, 111, 149, 0.3);
    outline-offset: 3px;
  }

  .stat-card strong {
    display: block;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    color: #176f95;
  }

  .stat-card span {
    margin-top: 0.55rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .feature {
    display: block;
    padding: 1.5rem;
    border: 1px solid #d7e0e4;
    border-radius: 18px;
    background: white;
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .feature:hover,
  .feature:focus-visible {
    transform: translateY(-3px);
    border-color: #176f95;
    box-shadow: 0 14px 34px rgba(16, 58, 88, 0.14);
  }

  .feature:focus-visible {
    outline: 3px solid rgba(23, 111, 149, 0.3);
    outline-offset: 3px;
  }

  .feature span {
    font-size: 2rem;
  }

  .latest {
    background: #e9f3f2;
  }

  .roundup-feature {
    display: grid;
    grid-template-columns: minmax(280px, 0.85fr) 1.15fr;
  }

  .roundup-feature img {
    width: 100%;
    height: 100%;
    min-height: 390px;
    object-fit: cover;
  }

  .roundup-feature .card-content {
    align-self: center;
    padding: 2.2rem;
  }

  @media (max-width: 1050px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 820px) {
    .feature-grid {
      grid-template-columns: 1fr 1fr;
    }

    .roundup-feature {
      grid-template-columns: 1fr;
    }

    .roundup-feature img {
      min-height: auto;
    }
  }

  @media (max-width: 540px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-card {
      min-height: 112px;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>