---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdvertisingPackagePage from "../../components/AdvertisingPackagePage.astro";

const proofs = [
  {
    label: "Editorial business presentation example",
    title: "Calhoun’s 2.0",
    description: "A real TWG business page showing how strong branding, useful local information, and event connections can be presented inside the guide.",
    image: "/images/businesses/calhouns-2-0-logo.png",
    alt: "Calhoun's 2.0 logo used on its Texoma Weekend Guide business page",
    href: "/businesses/calhouns-2-0/",
    linkLabel: "View the business page →"
  },
  {
    label: "Editorial business presentation example",
    title: "The Salty Heifer Cafe",
    description: "A real TWG local-business presentation showing the type of branded directory presence already built into the guide.",
    image: "/images/businesses/the-salty-heifer-cafe-denison-logo.jpg",
    alt: "The Salty Heifer Cafe logo used on its Texoma Weekend Guide business page",
    href: "/businesses/the-salty-heifer-cafe-denison/",
    linkLabel: "View the business page →"
  }
];
---

<BaseLayout
  title="Featured Business Advertising | Texoma Weekend Guide"
  description="Get ongoing Featured Business website visibility across Texoma Weekend Guide for $45 per month. Website-only advertising; social and Weekend Roundup promotion are separate products."
  image="/images/businesses/calhouns-2-0-logo-facebook-20260807.png"
>
  <AdvertisingPackagePage
    currentSlug="featured-business"
    eyebrow="Ongoing website visibility"
    title="Featured Business"
    price="$45/mo"
    priceNote="Recurring monthly website advertising. Cancel anytime."
    lead="Keep your business more visible across the TWG website all month."
    description="Featured Business is the ongoing website advertising product. It is designed for businesses that want stronger presentation and higher-visibility placement inside the Texoma Weekend Guide site and directory. It does not include Weekend Roundup advertising or social promotion; those are separate products so you only pay for the channels you actually want."
    includes={[
      "Featured treatment on your TWG business profile",
      "Enhanced business presentation with branding and expanded information when available",
      "Higher-visibility placement on relevant TWG website pages when applicable",
      "Eligibility for rotating featured website positions",
      "Priority business-profile updates",
      "Ongoing website visibility for as long as the subscription remains active"
    ]}
    bestFor={[
      "Restaurants, bars, and entertainment venues",
      "Lake businesses and tourism operators",
      "Retailers and service businesses",
      "Businesses that want an ongoing TWG website presence",
      "Advertisers who prefer website visibility without bundled social or roundup promotion"
    ]}
    ctaLabel="Start Featured Business — $45/month"
    ctaHref="https://buy.stripe.com/cNi8wPgdH6ez9d181O2kw00"
    secondaryCtaLabel="Want roundup advertising too?"
    secondaryCtaHref="/advertise/weekend-roundup-promotion/"
    timingNote="Featured website positions depend on geography, relevance, available inventory, and rotation. Continuous homepage placement is not guaranteed. Weekend Roundup Promotion and social promotion are purchased separately."
    transparencyNote="Calhoun’s 2.0 and The Salty Heifer Cafe examples shown here are editorial business presentations, not paid Featured Business placements. They demonstrate TWG’s business presentation style without implying those businesses purchased advertising."
    proofs={proofs}
  />
</BaseLayout>
