---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdvertisingPackagePage from "../../components/AdvertisingPackagePage.astro";

const proofs = [
  {
    label: "TWG event-promotion example",
    title: "Published event graphics",
    description: "Custom campaigns can combine the same visual work TWG already uses with expanded scheduling, multiple placements, and additional promotion.",
    image: "/images/1000042734.png",
    alt: "Texoma Weekend Guide published event graphic showing TWG promotional presentation"
  },
  {
    label: "TWG business-presentation example",
    title: "Local business presentation",
    description: "Larger campaigns can also build around business pages, launches, multiple roundup placements, and other TWG inventory when appropriate.",
    image: "/images/businesses/calhouns-2-0-logo.png",
    alt: "Calhoun's 2.0 logo used on its Texoma Weekend Guide business page",
    href: "/businesses/calhouns-2-0/",
    linkLabel: "View a TWG business page →"
  }
];
---

<BaseLayout
  title="Custom Texoma Advertising Campaigns | Texoma Weekend Guide"
  description="Request a custom Texoma Weekend Guide advertising campaign for festivals, grand openings, concert series, launches, multi-week sponsorships, and larger promotions."
  image="/images/1000042734.png"
>
  <AdvertisingPackagePage
    currentSlug="custom-campaigns"
    eyebrow="Larger and custom promotion"
    title="Custom Campaign"
    price="Custom quote"
    priceNote="Scope and pricing are confirmed before work begins."
    lead="Need more than one standard package? Build a campaign around what you actually need."
    description="Custom Campaigns are for promotions that go beyond one flyer, one post, one roundup placement, or one weekend sponsorship. TWG can combine multiple channels and multiple dates around a festival, launch, concert series, grand opening, seasonal promotion, or other larger campaign."
    includes={[
      "Multiple Weekend Roundup placements when appropriate",
      "Multiple social promotions or reminders",
      "Multi-event or event-series promotion",
      "Launch, grand-opening, or seasonal campaign planning",
      "Multi-week sponsorship concepts",
      "Custom combinations based on campaign goals, geography, timing, and available inventory"
    ]}
    bestFor={[
      "Festivals and multi-day events",
      "Grand openings and launches",
      "Concert or event series",
      "Multi-week business promotions",
      "Campaigns that do not fit neatly into a standard TWG package"
    ]}
    ctaLabel="Request a Custom Campaign"
    ctaHref="/advertise/#contact"
    secondaryCtaLabel="Compare standard packages"
    secondaryCtaHref="/advertise/"
    timingNote="TWG reviews custom campaign requests before confirming scope, availability, deliverables, and price. No custom campaign payment is required before those details are agreed upon."
    transparencyNote="The examples on this page show real TWG presentation work and components that may be used in a custom campaign; they are not represented as paid custom-campaign purchases."
    proofs={proofs}
  />
</BaseLayout>
