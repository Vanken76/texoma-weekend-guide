---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdvertisingPackagePage from "../../components/AdvertisingPackagePage.astro";

const proofs = [
  {
    label: "TWG graphic example",
    title: "Clean graphics built for quick discovery",
    description: "A published TWG graphic showing the readable, branded presentation style used for visual and social promotion.",
    image: "/images/1000042734.png",
    alt: "Texoma Weekend Guide published graphic showing the visual style used for social promotion"
  }
];
---

<BaseLayout
  title="Flyer + TWG Social Promotion | Texoma Weekend Guide"
  description="Get one custom promotional flyer or social graphic plus one dedicated Texoma Weekend Guide social media post for $20."
  image="/images/1000042734.png"
>
  <AdvertisingPackagePage
    currentSlug="flyer-social"
    eyebrow="Creative plus social distribution"
    title="Flyer + TWG Social Promotion"
    price="$20"
    priceNote="One-time payment. One graphic plus one dedicated TWG social post."
    lead="Get the graphic and put it in front of the TWG social audience."
    description="This package combines creative production with one distribution channel. TWG creates one custom promotional graphic for your business, event, service, or announcement and publishes one dedicated promotional post through a TWG social channel."
    includes={[
      "1 custom promotional flyer or social graphic",
      "1 dedicated TWG social media promotional post",
      "Copy and presentation tailored to the promotion",
      "One minor correction round on the graphic before publication"
    ]}
    bestFor={[
      "Local businesses and restaurants",
      "One-off announcements and specials",
      "Events that mainly need a visual and social push",
      "Grand openings, launches, and service promotions"
    ]}
    ctaLabel="Get Flyer + Social — $20"
    ctaHref="https://buy.stripe.com/5kQ14n3qV8mH1Kzgyk2kw08"
    secondaryCtaLabel="Need the graphic only for $10?"
    secondaryCtaHref="/advertise/custom-flyer/"
    timingNote="Turnaround and posting date depend on the information supplied and TWG’s production schedule. Time-sensitive promotions should be purchased with enough lead time for design and scheduling."
    transparencyNote="The published graphic shown here is a TWG presentation example and is not represented as a paid Flyer + TWG Social Promotion purchase."
    proofs={proofs}
  />
</BaseLayout>
